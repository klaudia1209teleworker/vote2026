## 4. TypeScript 封裝（強制建議）

集中模組（例：`utils/data-layer.ts`／`lib/gtm.ts`），元件**禁止**散落裸 `dataLayer.push`。

```ts
// utils/data-layer.ts
export type DataLayerEventName =
  | 'virtual_page_view'
  | 'generate_lead'
  | 'sign_up'
  | 'purchase'
  | 'cta_click'
  // 專案約定事件於此聯合型別擴充

type DataLayerPayload = Record<string, unknown>

declare global {
  interface Window {
    dataLayer?: DataLayerPayload[]
  }
}

export function ensureDataLayer(): DataLayerPayload[] {
  window.dataLayer = window.dataLayer || []
  return window.dataLayer
}

export function pushEvent(
  event: DataLayerEventName,
  payload: DataLayerPayload = {},
): void {
  if (typeof window === 'undefined') return
  ensureDataLayer().push({ event, ...payload })
}

export function pushVirtualPageView(path?: string, title?: string): void {
  pushEvent('virtual_page_view', {
    page_path: path ?? `${location.pathname}${location.search}`,
    page_title: title ?? document.title,
  })
}

export function pushGenerateLead(formId: string, leadType: string): void {
  pushEvent('generate_lead', { form_id: formId, lead_type: leadType })
}
```

使用處：

```ts
// ✅
pushGenerateLead('contact', 'demo_request')
pushVirtualPageView()

// ❌ 元件內直接操作
window.dataLayer.push({ event: 'generate_lead', email: user.email })
```

Consent 的 `update` 仍走 `305` 的 `utils/consent`／`gtag('consent', …)`，**不要**與業務 `pushEvent` 混在同一函式裡模糊職責。

