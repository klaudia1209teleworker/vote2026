## ⚠️ 動態 API 一律使用 async（Next.js 15+ 起強制，Next.js 16 已移除同步存取）

以下四個 API **必須 `await`**，同步存取（例如直接讀 `params.id`）在 Next.js 16 會編譯失敗或行為錯誤：

```tsx
// ✅ 正確：page.tsx / layout.tsx 中的 params、searchParams
interface PageProps {
  params: Promise<{ slug: string }>
  searchParams: Promise<{ [key: string]: string | string[] | undefined }>
}

export default async function ArticlePage({ params, searchParams }: PageProps) {
  const { slug } = await params
  const query = await searchParams
  // ...
}
```

```tsx
// ✅ 正確：cookies() / headers() / draftMode()
import { cookies, headers } from 'next/headers'

export default async function ProfilePage() {
  const cookieStore = await cookies()
  const headersList = await headers()
  // ...
}
```

```tsx
// ❌ 錯誤：同步存取（Next.js 14 的舊寫法，Next.js 16 會出錯）
export default function ArticlePage({ params }: { params: { slug: string } }) {
  const slug = params.slug // 不再支援
}
```

