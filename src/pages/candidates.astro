---
import Layout from '../layouts/Layout.astro';
import candidates from '../data/candidates.json';
import districts from '../data/districts.json';
import positions from '../data/positions.json';

const baseUrl = import.meta.env.BASE_URL;
const sampleCandidates = candidates.candidates.filter(c => c.isSample);

const directMunicipalities = districts.directMunicipalities.list;
const provincialCities = districts.provincialCities.list;
const counties = districts.counties.list;
---

<Layout title="候選人資訊" description="各選區候選人資訊（正式名單待 11/17 公告後更新）">
  <article class="space-y-8">
    <header>
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800 mb-4">
        👤 候選人資訊
      </h1>
      <div class="p-4 bg-amber-50 border border-amber-200 rounded-lg">
        <p class="text-amber-700">
          <strong>📢 資料狀態：</strong>候選人正式名單預計於 <strong>2026 年 11 月 17 日</strong>公告。
          本頁目前為架構示範，正式資料將於公告後更新。
        </p>
      </div>
    </header>

    <!-- Quick Access by City -->
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">🗺️ 依縣市查看候選人</h2>
      <p class="text-neutral-600 mb-4">
        選擇縣市快速查看各職位候選人名單。或者回到<a href={baseUrl} class="text-primary-600 hover:underline">首頁查詢您的選票</a>，直接連結到對應選區。
      </p>
      
      <div class="space-y-6">
        <!-- 六都 -->
        <div>
          <h3 class="text-sm font-medium text-neutral-500 mb-2">直轄市（六都）</h3>
          <div class="grid gap-2 sm:grid-cols-3">
            {directMunicipalities.map(city => (
              <a 
                href={`${baseUrl}candidates/district/mayor-municipal/${city}/`}
                class="p-3 bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg transition-colors"
              >
                <span class="font-medium text-neutral-800">{city}</span>
                <span class="text-neutral-400 ml-1">→</span>
              </a>
            ))}
          </div>
        </div>
        
        <!-- 省轄市 -->
        <div>
          <h3 class="text-sm font-medium text-neutral-500 mb-2">省轄市</h3>
          <div class="grid gap-2 sm:grid-cols-3">
            {provincialCities.map(city => (
              <a 
                href={`${baseUrl}candidates/district/mayor-county/${city}/`}
                class="p-3 bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg transition-colors"
              >
                <span class="font-medium text-neutral-800">{city}</span>
                <span class="text-neutral-400 ml-1">→</span>
              </a>
            ))}
          </div>
        </div>
        
        <!-- 縣 -->
        <div>
          <h3 class="text-sm font-medium text-neutral-500 mb-2">縣</h3>
          <div class="grid gap-2 sm:grid-cols-3 lg:grid-cols-4">
            {counties.map(city => (
              <a 
                href={`${baseUrl}candidates/district/mayor-county/${city}/`}
                class="p-3 bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg transition-colors"
              >
                <span class="font-medium text-neutral-800">{city}</span>
                <span class="text-neutral-400 ml-1">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Official Sources -->
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">🔗 官方候選人查詢</h2>
      
      <div class="grid gap-4 sm:grid-cols-2">
        <a 
          href="https://info.cec.gov.tw/vote2026/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
        >
          <p class="font-medium text-primary-700">中選會選舉專區</p>
          <p class="text-sm text-primary-600">官方候選人查詢系統</p>
        </a>
        
        <a 
          href="https://bulletin.cec.gov.tw/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
        >
          <p class="font-medium text-primary-700">選舉公報</p>
          <p class="text-sm text-primary-600">候選人完整政見</p>
        </a>
        
        <a 
          href="https://pdps-dec.cec.gov.tw/release/formal/HomePage.html" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-neutral-50 rounded-lg hover:bg-neutral-100 transition-colors"
        >
          <p class="font-medium text-neutral-700">財產申報查詢</p>
          <p class="text-sm text-neutral-500">縣市長、縣市議員（不含基層）</p>
        </a>
        
        <a 
          href="https://journal.th.gov.tw/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-neutral-50 rounded-lg hover:bg-neutral-100 transition-colors"
        >
          <p class="font-medium text-neutral-700">議事錄總庫</p>
          <p class="text-sm text-neutral-500">現任議員質詢紀錄</p>
        </a>
      </div>
    </section>

    <!-- Data Schema -->
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">📋 候選人資料架構</h2>
      <p class="text-neutral-600 mb-4">
        本站候選人資料將依以下結構建置，以利使用者評估候選人：
      </p>
      
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="p-4 bg-neutral-50 rounded-lg">
          <h3 class="font-medium text-neutral-700 mb-2">基本資料</h3>
          <ul class="space-y-1 text-sm text-neutral-600">
            <li>• 姓名、號次</li>
            <li>• 政黨（或無黨籍）</li>
            <li>• 參選職位、選區</li>
            <li>• 選舉公報連結</li>
            <li>• 是否為現任</li>
          </ul>
        </div>
        
        <div class="p-4 bg-green-50 rounded-lg">
          <h3 class="font-medium text-green-700 mb-2">現任議員評估資料</h3>
          <ul class="space-y-1 text-sm text-green-600">
            <li>• 大會出席率</li>
            <li>• 委員會出席率</li>
            <li>• 質詢主題與是否追蹤</li>
            <li>• 資料來源連結</li>
          </ul>
        </div>
        
        <div class="p-4 bg-blue-50 rounded-lg">
          <h3 class="font-medium text-blue-700 mb-2">新人候選人評估資料</h3>
          <ul class="space-y-1 text-sm text-blue-600">
            <li>• 專業背景</li>
            <li>• 公共參與經歷</li>
            <li>• 資料來源連結</li>
          </ul>
        </div>
        
        <div class="p-4 bg-amber-50 rounded-lg">
          <h3 class="font-medium text-amber-700 mb-2">資料驗證</h3>
          <ul class="space-y-1 text-sm text-amber-600">
            <li>• 官方來源 URL</li>
            <li>• 最後驗證日期</li>
            <li>• 所有資料皆可追溯來源</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Sample Data (hidden in production but shown for demo) -->
    <section class="p-6 bg-neutral-100 border border-neutral-300 rounded-xl">
      <h2 class="text-lg font-semibold text-neutral-700 mb-4">🧪 範例資料（僅供架構示範）</h2>
      <p class="text-sm text-neutral-500 mb-4">
        以下為資料結構示範用的假資料，正式上線時將替換為真實候選人資訊。
      </p>
      
      <div class="space-y-4">
        {sampleCandidates.map(candidate => (
          <div class="p-4 bg-white rounded-lg border border-dashed border-neutral-300">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div>
                <span class="inline-block px-2 py-0.5 bg-red-100 text-red-600 text-xs rounded mb-2">
                  ⚠️ 範例資料
                </span>
                <h3 class="font-medium text-neutral-800">
                  {candidate.number} 號 {candidate.name}
                </h3>
                <p class="text-sm text-neutral-500">
                  {candidate.city} {candidate.district} · {candidate.party || '無黨籍'}
                </p>
              </div>
              <span class={`text-xs px-2 py-1 rounded ${candidate.isIncumbent ? 'bg-blue-100 text-blue-700' : 'bg-neutral-100 text-neutral-600'}`}>
                {candidate.isIncumbent ? '現任' : '挑戰者'}
              </span>
            </div>
            
            {candidate.checks?.incumbent && (
              <div class="mt-3 p-3 bg-neutral-50 rounded text-sm">
                <p class="text-neutral-700">
                  <strong>出席率：</strong>大會 {candidate.checks.incumbent.councilAttendance.general} / 委員會 {candidate.checks.incumbent.councilAttendance.committee}
                </p>
                {candidate.checks.incumbent.interpellations?.map(interp => (
                  <p class="text-neutral-600 mt-1">
                    <strong>質詢：</strong>{interp.topic} ({interp.date}) 
                    {interp.followUp && <span class="text-green-600 ml-1">✓ 持續追蹤</span>}
                  </p>
                ))}
              </div>
            )}
            
            {candidate.checks?.newcomer && (
              <div class="mt-3 p-3 bg-neutral-50 rounded text-sm">
                <p class="text-neutral-700">
                  <strong>專業背景：</strong>{candidate.checks.newcomer.professionalBackground}
                </p>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Contributing -->
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">📝 如何貢獻資料</h2>
      <p class="text-neutral-600 mb-4">
        本站候選人資料以 JSON 格式儲存，歡迎協助補充。貢獻方式：
      </p>
      
      <ol class="space-y-3 text-neutral-600">
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full text-sm font-bold">1</span>
          <span>參閱 <code class="text-sm bg-neutral-100 px-1 py-0.5 rounded">src/data/candidates.json</code> 的資料結構</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full text-sm font-bold">2</span>
          <span>僅使用<strong>官方來源</strong>（中選會公告、選舉公報、議會紀錄）</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full text-sm font-bold">3</span>
          <span>每筆資料須附 <code class="text-sm bg-neutral-100 px-1 py-0.5 rounded">officialSourceUrl</code> 與 <code class="text-sm bg-neutral-100 px-1 py-0.5 rounded">lastVerified</code></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full text-sm font-bold">4</span>
          <span>提交 Pull Request，說明資料來源</span>
        </li>
      </ol>
      
      <div class="mt-4 p-4 bg-red-50 rounded-lg">
        <p class="text-sm text-red-700">
          <strong>⚠️ 重要原則：</strong>
        </p>
        <ul class="mt-2 space-y-1 text-sm text-red-600">
          <li>• 不可捏造、推測或使用非官方來源</li>
          <li>• 不可包含主觀評價、推薦或排名</li>
          <li>• 所有數據須可回溯至原始官方文件</li>
        </ul>
      </div>
    </section>

    <nav class="flex justify-between pt-8 border-t border-neutral-200">
      <a href={`${baseUrl}cooperation/`} class="text-primary-600 hover:underline">
        ← 合作案例
      </a>
      <a href={`${baseUrl}about/`} class="text-primary-600 hover:underline">
        關於本站 →
      </a>
    </nav>
  </article>
</Layout>
