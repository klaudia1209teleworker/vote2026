---
import Layout from '../layouts/Layout.astro';
import BallotLookup from '../components/BallotLookup.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="查詢選票">
  <div class="space-y-6">
    <!-- Election Header - specific, not generic -->
    <header class="border-b border-neutral-200 pb-4">
      <p class="text-sm text-neutral-500 mb-1">2026 年 11 月 28 日（六）08:00–16:00</p>
      <h1 class="text-xl font-semibold text-neutral-800">
        九合一地方公職人員選舉暨全國性公民投票
      </h1>
      <p class="text-sm text-neutral-600 mt-1">
        含公投第 22 案（18-19 歲僅投公投）
      </p>
    </header>

    <!-- Ballot Lookup - the main feature -->
    <BallotLookup />

    <!-- Notices -->
    <section class="text-sm space-y-2 text-neutral-600 border-t border-neutral-200 pt-4">
      <p>投票所查詢 11/23 起開放：<a href="https://www.ris.gov.tw/info-electionVotePlaceQuery/app/aw0702VPQ/main/" target="_blank" rel="noopener" class="text-accent-600 underline">戶政司查詢系統</a></p>
      <p>選舉公報預計 11/25 前送達各戶</p>
      <p>民調禁令：11/18 起至投票結束，不得發布選舉民調</p>
      <p>禁止攜帶手機進入圈票處拍照（選罷法 §65）</p>
    </section>

    <!-- Secondary Links -->
    <nav class="border-t border-neutral-200 pt-4">
      <ul class="grid gap-px bg-neutral-200 sm:grid-cols-2 lg:grid-cols-4 rounded overflow-hidden">
        <li>
          <a href={`${baseUrl}positions/`} class="block bg-white px-4 py-3 hover:bg-neutral-50">
            <span class="font-medium text-neutral-800">職務介紹</span>
            <span class="block text-sm text-neutral-500 mt-0.5">市長、議員、里長等 9 種職務</span>
          </a>
        </li>
        <li>
          <a href={`${baseUrl}how-to-judge/`} class="block bg-white px-4 py-3 hover:bg-neutral-50">
            <span class="font-medium text-neutral-800">判斷候選人</span>
            <span class="block text-sm text-neutral-500 mt-0.5">查詢議員出席與質詢紀錄</span>
          </a>
        </li>
        <li>
          <a href={`${baseUrl}voting-day/`} class="block bg-white px-4 py-3 hover:bg-neutral-50">
            <span class="font-medium text-neutral-800">投票須知</span>
            <span class="block text-sm text-neutral-500 mt-0.5">證件、圈選方式、禁止事項</span>
          </a>
        </li>
        <li>
          <a href={`${baseUrl}candidates/`} class="block bg-white px-4 py-3 hover:bg-neutral-50">
            <span class="font-medium text-neutral-800">候選人查詢</span>
            <span class="block text-sm text-neutral-500 mt-0.5">正式名單 11/17 公告後更新</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Video - demoted, smaller -->
    <details class="border border-neutral-200 rounded">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium text-neutral-700 hover:bg-neutral-50 select-none">
        選舉制度影片（讀字生活）
      </summary>
      <div class="p-4 pt-0">
        <div class="relative w-full aspect-video bg-neutral-100 rounded overflow-hidden">
          <iframe 
            src="https://www.youtube-nocookie.com/embed/f6VOJumCwIg"
            title="讀字生活 Ep02 - 九合一選舉各職務介紹"
            loading="lazy"
            allowfullscreen
            class="absolute inset-0 w-full h-full"
          ></iframe>
        </div>
        <p class="text-xs text-neutral-500 mt-2">
          來源：<a href="https://www.youtube.com/@duzishenghuo" target="_blank" rel="noopener" class="underline">讀字生活</a> YouTube
        </p>
      </div>
    </details>
  </div>
</Layout>
