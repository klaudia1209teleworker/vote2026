---
import Layout from '../layouts/Layout.astro';
import BallotLookup from '../components/BallotLookup.astro';
import districts from '../data/districts.json';
import positions from '../data/positions.json';
import candidates from '../data/candidates.json';

const baseUrl = import.meta.env.BASE_URL;
const updatedAt = districts.metadata.lastUpdated;
const cityCount =
  districts.directMunicipalities.list.length +
  districts.provincialCities.list.length +
  districts.counties.list.length;
const positionCount = positions.positions.length;
const candidateCount = (candidates as unknown[]).length;

const quickLinks = [
  { href: `${baseUrl}positions/`, title: '職務介紹', text: '九種地方公職的職責' },
  { href: `${baseUrl}candidates/`, title: '候選人', text: '依縣市與選區查看名單' },
  { href: `${baseUrl}voting-day/`, title: '投票指南', text: '時間、證件與禁止事項' },
  { href: `${baseUrl}how-to-judge/`, title: '判斷候選人', text: '出席、質詢與提案紀錄' },
];
---

<Layout title="首頁" description="2026 九合一地方選舉資訊彙整：查詢選票、縣市候選人與投票須知">
  <link slot="head" rel="preconnect" href="https://www.youtube-nocookie.com" />
  <link slot="head" rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
  <div class="space-y-6">
    <header class="hero">
      <div>
        <p class="text-sm hero-muted tabular-nums">投票日 2026-11-28（六）08:00–16:00</p>
        <h1 class="page-title mt-1 text-balance">2026 九合一地方選舉資訊彙整</h1>
        <p class="mt-2 hero-muted">
          九合一地方公職人員選舉暨全國性公民投票。依戶籍查會領到的選票，並查看已公告的職務說明與候選人資料。
        </p>
        <p class="mt-1 text-sm hero-muted">同日舉行公投第 22 案。18–19 歲僅可投公投。</p>
      </div>
      <section class="hero-overview" aria-labelledby="overview-title">
        <h2 id="overview-title" class="hero-overview-title">選舉摘要</h2>
        <dl class="mt-2 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div>
            <dt class="text-sm hero-muted">縣市</dt>
            <dd class="kpi-value mt-1">{cityCount}</dd>
            <p class="mt-1 text-xs hero-muted">直轄市、省轄市與縣。來源：中選會地方選舉劃分公告。</p>
          </div>
          <div>
            <dt class="text-sm hero-muted">選舉類別</dt>
            <dd class="kpi-value mt-1">{positionCount}<span class="ml-1 text-sm font-semibold">種職務</span></dd>
            <p class="mt-1 text-xs hero-muted">公投第 22 案同日舉行，不計入這 {positionCount} 種地方公職。</p>
          </div>
          <div>
            <dt class="text-sm hero-muted">本站收錄候選人</dt>
            <dd class="kpi-value mt-1">{candidateCount.toLocaleString()}</dd>
            <p class="mt-1 text-xs hero-muted">來源：中選會及各縣市選委會公告。不是推薦名單。</p>
          </div>
          <div>
            <dt class="text-sm hero-muted">資料更新</dt>
            <dd class="kpi-value mt-1 text-2xl">{updatedAt}</dd>
            <p class="mt-1 text-xs hero-muted">來源：中選會及各縣市選委會公告。</p>
          </div>
        </dl>
      </section>
      <div id="lookup" class="hero-lookup scroll-mt-24">
        <BallotLookup />
      </div>
    </header>

    <nav aria-label="快捷入口">
      <ul class="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
        {quickLinks.map((link) => (
          <li>
            <a href={link.href} class="quick-link">
              <span class="font-semibold text-strong">{link.title}</span>
              <span class="text-sm text-secondary">{link.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section aria-labelledby="timeline-title">
      <h2 id="timeline-title" class="section-title">選舉時程</h2>
      <p class="mt-1 text-sm text-secondary">狀態依目前頁面已記載的公告用語，推估日期標為預計。</p>
      <ol class="timeline mt-3">
        <li data-state="confirmed">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">已公告</span>
            <time class="text-sm tabular-nums text-secondary" datetime="2026-11-18">2026-11-18 起</time>
          </div>
          <p class="mt-1">至投票結束，不得發布選舉民調。</p>
        </li>
        <li data-state="confirmed">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">已公告</span>
            <time class="text-sm tabular-nums text-secondary" datetime="2026-11-23">2026-11-23 起</time>
          </div>
          <p class="mt-1">
            投票所查詢開放。
            <a href="https://www.ris.gov.tw/info-electionVotePlaceQuery/app/aw0702VPQ/main/" target="_blank" rel="noopener" class="underline">戶政司查詢系統</a>
          </p>
        </li>
        <li>
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">預計</span>
            <time class="text-sm tabular-nums text-secondary" datetime="2026-11-25">2026-11-25 前</time>
          </div>
          <p class="mt-1">選舉公報預計送達各戶。</p>
        </li>
        <li data-state="confirmed">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">已公告</span>
            <time class="text-sm tabular-nums text-secondary" datetime="2026-11-28">2026-11-28 08:00–16:00</time>
          </div>
          <p class="mt-1">投票日。禁止攜帶手機進入圈票處拍照。</p>
        </li>
      </ol>
    </section>

    <section aria-labelledby="guide-title">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 id="guide-title" class="section-title">投票指南</h2>
        <a href={`${baseUrl}voting-day/`} class="btn btn-secondary">完整說明</a>
      </div>
      <ul class="mt-2 grid gap-2 md:grid-cols-2">
        <li class="ui-card">
          <h3 class="font-semibold text-strong">投票時間</h3>
          <p class="mt-2 text-sm text-secondary tabular-nums">2026-11-28（六）08:00–16:00</p>
        </li>
        <li class="ui-card">
          <h3 class="font-semibold text-strong">應備證件（三選一）</h3>
          <p class="mt-2 text-sm text-secondary">國民身分證、有效駕駛執照或有效護照。健保卡不能當作投票證件。</p>
        </li>
        <li class="ui-card">
          <h3 class="font-semibold text-strong">投票所</h3>
          <p class="mt-2 text-sm text-secondary">11/23 起可查戶政司系統。選舉公報與投票通知單預計 11/25 前送達。</p>
        </li>
        <li class="ui-card">
          <h3 class="font-semibold text-strong">投票注意事項</h3>
          <p class="mt-2 text-sm text-secondary">禁止攜帶手機進入圈票處拍照。實際選票以投票當日領取為準。</p>
        </li>
      </ul>
    </section>

    <section class="ui-card" aria-labelledby="tribute-title">
      <h2 id="tribute-title" class="section-title">知識來源・特別致敬</h2>
      <p class="mt-1 text-sm text-secondary">
        本網站的知識架構受到這部影片啟發。選舉事實仍依官方公告查證。嵌入不表示原作者認可或背書本站。
      </p>
      <div class="mt-3 grid gap-3 lg:grid-cols-[minmax(0,1.6fr)_minmax(14rem,0.7fr)] lg:items-center">
        <div class="relative aspect-video overflow-hidden rounded-lg bg-muted">
          <iframe
            src="https://www.youtube-nocookie.com/embed/f6VOJumCwIg"
            title="讀字生活 Ep02 - 九合一選舉各職務介紹"
            loading="eager"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            class="absolute inset-0 h-full w-full"
          ></iframe>
        </div>
        <div class="space-y-1 text-sm">
          <p class="font-semibold text-strong">讀字生活 Ep02：九合一各職務職責與權限</p>
          <p class="text-secondary">頻道：讀字生活</p>
          <a href="https://www.youtube.com/watch?v=f6VOJumCwIg" target="_blank" rel="noopener" class="underline">
            前往 YouTube 觀看原影片
          </a>
        </div>
      </div>
    </section>

    <section class="ui-card" aria-labelledby="notices-title">
      <h2 id="notices-title" class="section-title">官方資訊</h2>
      <ul class="mt-2 divide-y divide-line">
        <li class="flex items-center justify-between gap-3 py-2">
          <p><span class="badge mr-2">官方</span>中選會選舉專區</p>
          <a href="https://info.cec.gov.tw/vote2026/" target="_blank" rel="noopener" class="btn btn-tertiary">前往</a>
        </li>
        <li class="flex items-center justify-between gap-3 py-2">
          <p><span class="badge mr-2">官方</span>選舉公報</p>
          <a href="https://bulletin.cec.gov.tw/" target="_blank" rel="noopener" class="btn btn-tertiary">前往</a>
        </li>
        <li class="flex items-center justify-between gap-3 py-2">
          <p><span class="badge mr-2">官方</span>戶政司投票所查詢 <span class="text-sm text-secondary">11/23 起開放</span></p>
          <a href="https://www.ris.gov.tw/info-electionVotePlaceQuery/app/aw0702VPQ/main/" target="_blank" rel="noopener" class="btn btn-tertiary">前往</a>
        </li>
      </ul>
    </section>
  </div>
</Layout>
