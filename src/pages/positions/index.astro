---
import Layout from '../../layouts/Layout.astro';
import positions from '../../data/positions.json';

const baseUrl = import.meta.env.BASE_URL;

const positionsByCategory = {
  '首長': positions.positions.filter(p => p.category === '首長'),
  '民意代表': positions.positions.filter(p => p.category === '民意代表'),
  '基層': positions.positions.filter(p => p.category === '基層')
};

const categoryDescriptions = {
  '首長': '地方政府行政首長，負責市政方向與團隊組建',
  '民意代表': '代表選民監督政府，審查預算、質詢首長',
  '基層': '最貼近居民生活的民選代表'
};

const categoryIcons = {
  '首長': '🏛️',
  '民意代表': '🎤',
  '基層': '🏘️'
};
---

<Layout title="職務介紹" description="了解九合一選舉中市長、議員、里長等九種職務的職責、待遇與選擇標準">
  <div class="space-y-8">
    <section>
      <h1 class="page-title mb-4">
        📋 九種職務介紹
      </h1>
      <p class="text-neutral-600 mb-6">
        九合一選舉包含九種地方公職，依據您的戶籍地不同，實際會投的票也不同。
        了解每個職位的職責，有助於您做出更好的選擇。
      </p>
    </section>

    <section class="p-6 bg-blue-50 border border-blue-200 rounded-xl">
      <h2 class="font-semibold text-blue-800 mb-3">💡 您的選票像一張聘書</h2>
      <p class="text-sm text-blue-700">
        選票不是「選爸媽」，而是「發聘書」。這些人當選後是來替我們工作、領我們付的薪水。
        我們是老闆，他們是員工。投票後還要持續關心他們有沒有好好做事。
      </p>
      <p class="text-xs text-blue-600 mt-2">
        — 參考自<a href="https://www.youtube.com/watch?v=f6VOJumCwIg" target="_blank" rel="noopener" class="underline">讀字生活 Ep02</a>
      </p>
    </section>

    {Object.entries(positionsByCategory).map(([category, categoryPositions]) => (
      <section>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl">{categoryIcons[category]}</span>
          <div>
            <h2 class="text-xl font-semibold text-neutral-800">{category}級</h2>
            <p class="text-sm text-neutral-500">{categoryDescriptions[category]}</p>
          </div>
        </div>
        
        <div class="grid gap-4 sm:grid-cols-2">
          {categoryPositions.map(position => (
            <a 
              href={`${baseUrl}positions/${position.id}/`}
              class="group block p-5 bg-white rounded-xl shadow-sm border border-neutral-200 hover:border-primary-300 hover:shadow-md transition-all"
            >
              <h3 class="text-lg font-semibold text-neutral-800 group-hover:text-primary-700 mb-2">
                {position.name}
              </h3>
              <p class="text-sm text-neutral-600 mb-3 line-clamp-2">
                {position.description}
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="px-2 py-1 bg-neutral-100 rounded text-neutral-600">
                  任期 {position.term} 年
                </span>
                {position.applicableTo && (
                  <span class="px-2 py-1 bg-primary-50 rounded text-primary-700">
                    {Array.isArray(position.applicableTo) ? position.applicableTo.join('、') : position.applicableTo}
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="p-6 bg-neutral-100 border border-neutral-200 rounded-xl">
      <h2 class="font-semibold text-neutral-800 mb-3">📊 九合一選舉職位一覽</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-300">
              <th class="text-left py-2 px-3">職位</th>
              <th class="text-left py-2 px-3">適用地區</th>
              <th class="text-left py-2 px-3">類型</th>
            </tr>
          </thead>
          <tbody>
            {positions.positions.map(p => (
              <tr class="border-b border-neutral-200 hover:bg-white">
                <td class="py-2 px-3">
                  <a href={`${baseUrl}positions/${p.id}/`} class="text-primary-600 hover:underline">
                    {p.name}
                  </a>
                </td>
                <td class="py-2 px-3 text-neutral-600">
                  {Array.isArray(p.applicableTo) ? p.applicableTo.join('、') : p.applicableTo}
                </td>
                <td class="py-2 px-3 text-neutral-600">{p.category}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
