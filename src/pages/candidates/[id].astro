---
import Layout from '../../layouts/Layout.astro';
import MetricWithTooltip from '../../components/MetricWithTooltip.astro';
import ExpandableRecordList from '../../components/ExpandableRecordList.astro';
import candidates from '../../data/candidates.json';
import positions from '../../data/positions.json';
import bulletinData from '../../data/bulletin.json';
import incumbentsData from '../../data/incumbents.json';
import { getCandidateKey } from '../../utils/candidateKey';
import {
  attendanceUnavailableLabel,
  buildDistrictAverages,
  formatMetricRatio,
  getInterpellationCount,
  getProposalCount,
  getProposalItems,
  type IncumbentEntry,
} from '../../utils/incumbentStats';

const baseUrl = import.meta.env.BASE_URL;

type BulletinEntry = {
  county: string;
  position: string;
  district: string;
  name: string;
  ballotNumber: number;
  platform: string;
  platformFormat: 'text' | 'image';
  education: string[];
  experience: string[];
  birthDateAsPrinted?: string;
  gender?: string;
  birthPlace?: string;
  partyAsPrinted?: string;
  declarationsAsPrinted?: { text: string; checked: boolean }[];
  sourceUrl?: string;
  sourcePage?: number;
  sourceArticleUrl?: string;
  asOf?: string;
};

function getBulletinImagePath(entry: BulletinEntry): string | null {
  if (entry.platformFormat !== 'image' || !entry.sourceUrl || !entry.sourcePage) {
    return null;
  }
  const urlMatch = entry.sourceUrl.match(/\/([a-f0-9-]+)\.pdf$/i);
  if (!urlMatch) return null;
  const fileId = urlMatch[1].substring(0, 8);
  return `bulletin-pages/${fileId}-p${entry.sourcePage}.webp`;
}

const districtAverages = buildDistrictAverages(
  incumbentsData as Record<string, IncumbentEntry>
);

export function getStaticPaths() {
  function generateCandidateId(c: any): string {
    return `${c.county}-${c.position}-${c.district || c.districtOfficial || ''}-${c.name}`.replace(/[^a-zA-Z0-9\u4e00-\u9fff-]/g, '').toLowerCase();
  }
  
  const nonVillageChiefCandidates = (candidates as any[]).filter(c => c.position !== 'village-chief');
  
  return nonVillageChiefCandidates.map(candidate => ({
    params: { id: generateCandidateId(candidate) },
    props: { candidate }
  }));
}

const { candidate } = Astro.props;

const position = positions.positions.find(p => p.id === candidate.position);
const positionName = position?.name || candidate.position;
const shortName = position?.shortName || positionName;

function getStatusBadge(status: string, registeredOn?: string): { label: string; class: string; fullLabel: string } | null {
  return null;
}

function getPartyDisplay(party: string | null, partyAsListed: string | null): string {
  if (party) return party;
  if (partyAsListed === '無' || partyAsListed === null) return '無黨籍推薦';
  return partyAsListed;
}

const statusBadge = getStatusBadge(candidate.status, candidate.registeredOn);
const partyDisplay = getPartyDisplay(candidate.party, candidate.partyAsListed);

const candidateKey = getCandidateKey(candidate);
const bulletin = (bulletinData as Record<string, BulletinEntry>)[candidateKey] || null;
const bulletinImagePath = bulletin ? getBulletinImagePath(bulletin) : null;
const hasPlatformText = Boolean(bulletin?.platformFormat === 'text' && bulletin.platform?.trim());
const hasPlatformImage = Boolean(bulletin?.platformFormat === 'image' && bulletinImagePath);

const incumbentKey = candidateKey;
const incumbentRaw = (incumbentsData as Record<string, IncumbentEntry>)[incumbentKey];
const incumbent = incumbentRaw?.incumbency?.publish ? incumbentRaw : null;

const districtAvgKey = incumbentKey.split('|').slice(0, 3).join('|');
const districtAvg = districtAverages[districtAvgKey] || null;

const interpellationCount = incumbent ? getInterpellationCount(incumbent) : null;
const proposalCount = incumbent ? getProposalCount(incumbent) : null;
const proposalItems = incumbent ? getProposalItems(incumbent) : [];
const interpellationItems = incumbent?.interpellation?.items ?? [];

const attendanceLabel = incumbent ? attendanceUnavailableLabel(incumbent.attendance) : '';
const attendanceCounts = incumbent?.attendance?.plenaryCounts;
const attendancePlenary =
  incumbent?.attendance?.status === 'available' && typeof incumbent.attendance.plenary === 'number'
    ? incumbent.attendance.plenary
    : null;
const attendanceFootnote =
  attendancePlenary != null
    ? attendanceCounts
      ? `出席 ${attendanceCounts.attended} 場／應出席 ${attendanceCounts.denominator} 場。分子是大會出席場次，分母含請假與缺席；同一場兩份名單都有的 ${attendanceCounts.excludedBothLists} 場已剔除。委員會未計算。右側只跟同選區有數值的現任者比。`
      : '分子是大會出席場次，分母含請假與缺席；同一場兩份名單都有的場次已剔除。委員會未計算。只跟同選區有數值的現任者比。'
    : attendanceLabel || undefined;
const attendanceCommittee =
  incumbent?.attendance?.status === 'available' && typeof incumbent.attendance.committee === 'number'
    ? incumbent.attendance.committee
    : null;

const interpellationList = interpellationItems.map((item) => {
  const links: { label: string; href: string }[] = [];
  if (item.videoUrl) links.push({ label: '影音紀錄', href: item.videoUrl });
  if (item.transcriptUrl) links.push({ label: '逐字稿', href: item.transcriptUrl });
  if (item.documentUrl) links.push({ label: '質詢資料 PDF', href: item.documentUrl });
  if (item.sourceUrl && !links.some((l) => l.href === item.sourceUrl)) {
    links.push({ label: '來源', href: item.sourceUrl });
  }

  const secondary = [
    item.date || item.dateAsRecorded,
    item.time,
    item.session,
  ]
    .filter(Boolean)
    .join(' · ');

  return {
    primary: item.title || item.listedAs || '（無標題）',
    secondary: secondary || undefined,
    meta: item.department
      ? `部門：${item.department}`
      : item.councillorsAsRecorded
        ? `列名：${item.councillorsAsRecorded}`
        : undefined,
    links: links.length > 0 ? links : undefined,
  };
});

const proposalList = proposalItems.map((item) => {
  const outcomeLines = item.outcome
    ? Object.entries(item.outcome)
        .filter(([, value]) => Boolean(value))
        .map(([key, value]) => `${key}：${value}`)
    : undefined;

  return {
    primary: item.title || '（無標題）',
    secondary: item.session,
    outcomeLines,
    links: item.sourceUrl ? [{ label: '案件詳情', href: item.sourceUrl }] : undefined,
  };
});

const districtPageUrl = (() => {
  const positionId = candidate.position;
  const city = candidate.county;
  
  if (positionId === 'mayor-municipal' || positionId === 'mayor-county') {
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'councilor-municipal' || positionId === 'councilor-county') {
    const districtName = candidate.districtOfficial || candidate.district;
    if (districtName) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(districtName)}/`;
    }
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'township-mayor' || positionId === 'township-representative') {
    const township = candidate.district;
    if (township) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(township)}/`;
    }
  }
  
  if (positionId === 'district-mayor' || positionId === 'district-representative') {
    const district = candidate.district;
    if (district) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(district)}/`;
    }
  }
  
  return `${baseUrl}candidates/`;
})();

const pageTitle = `${candidate.name} - ${positionName}候選人`;
const pageUrl = `https://klaudia1209teleworker.github.io/vote2026/candidates/${encodeURIComponent(candidate.county)}-${encodeURIComponent(candidate.position)}-${encodeURIComponent(candidate.district || candidate.districtOfficial || '')}-${encodeURIComponent(candidate.name)}/`;
const reportSubject = encodeURIComponent(`[勘誤] ${candidate.name}`);
const reportBody = encodeURIComponent(`頁面網址：${pageUrl}\n\n哪裡有錯：\n\n正確內容：\n\n官方來源連結：\n`);
const reportMailto = `mailto:kay-ycqbxw+vote2026@mail.grokbot.com?subject=${reportSubject}&body=${reportBody}`;
---

<Layout title={`${candidate.name} - ${positionName}候選人`} description={`${candidate.county}${candidate.district || ''} ${positionName}候選人 ${candidate.name}`}>
  <article class="space-y-6">
    <header class="border-b border-line pb-4">
      <nav class="mb-3 text-sm text-secondary">
        <a href={`${baseUrl}candidates/`} class="underline">候選人</a>
        <span class="mx-1">/</span>
        <a href={districtPageUrl} class="underline">{candidate.county} {candidate.districtOfficial || candidate.district || ''}</a>
        <span class="mx-1">/</span>
        <span class="text-ink">{candidate.name}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-3">
        {candidate.number != null && (
          <span class="text-2xl font-semibold tabular-nums text-secondary">{candidate.number}</span>
        )}
        <h1 class="page-title">{candidate.name}</h1>
        {incumbent && <span class="badge">現任</span>}
      </div>
      <p class="mt-2 text-sm text-secondary">
        {candidate.county} {candidate.districtOfficial || candidate.district || ''} · {positionName} · {partyDisplay}
      </p>
    </header>

    <section class="ui-card overflow-hidden p-0" aria-labelledby="profile-title">
      <div class="border-b border-line bg-muted px-4 py-2">
        <h2 id="profile-title" class="text-sm font-semibold text-strong">登記資料</h2>
      </div>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-line">
          {candidate.number != null && (
            <tr>
              <th class="w-28 px-4 py-2 text-left font-medium text-secondary">號次</th>
              <td class="px-4 py-2 tabular-nums text-ink">{candidate.number} 號</td>
            </tr>
          )}
          <tr>
            <th class="w-28 px-4 py-2 text-left font-medium text-secondary">政黨</th>
            <td class="px-4 py-2 text-ink">{partyDisplay}</td>
          </tr>
          {candidate.registeredOn && (
            <tr>
              <th class="w-28 px-4 py-2 text-left font-medium text-secondary">登記日期</th>
              <td class="px-4 py-2 text-ink">{candidate.registeredOn}</td>
            </tr>
          )}
        </tbody>
      </table>
    </section>

    <section class="ui-card overflow-hidden p-0" aria-labelledby="bulletin-title">
      <div class="border-b border-line bg-muted px-4 py-2">
        <h2 id="bulletin-title" class="text-sm font-semibold text-strong">選舉公報</h2>
      </div>
      
      {bulletin ? (
        <div class="divide-y divide-neutral-100">
          {/* Basic Info from Bulletin */}
          <div class="px-3 py-3">
            <table class="w-full text-sm">
              <tbody>
                {bulletin.birthDateAsPrinted && (
                  <tr>
                    <td class="text-neutral-500 pr-4 py-0.5">出生年月日</td>
                    <td class="text-neutral-800">{bulletin.birthDateAsPrinted}</td>
                  </tr>
                )}
                {bulletin.gender && (
                  <tr>
                    <td class="text-neutral-500 pr-4 py-0.5">性別</td>
                    <td class="text-neutral-800">{bulletin.gender}</td>
                  </tr>
                )}
                {bulletin.birthPlace && (
                  <tr>
                    <td class="text-neutral-500 pr-4 py-0.5">出生地</td>
                    <td class="text-neutral-800">{bulletin.birthPlace}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          {/* Platform */}
          <div class="px-4 py-3">
            <h3 class="mb-2 text-sm font-semibold text-strong">政見</h3>
            {hasPlatformText ? (
              <div class="text-neutral-800 whitespace-pre-wrap text-sm leading-relaxed">
                {bulletin.platform}
              </div>
            ) : hasPlatformImage ? (
              <div>
                <img
                  src={`${baseUrl}${bulletinImagePath}`}
                  alt={`${candidate.name}選舉公報政見原圖`}
                  class="max-w-full h-auto border border-neutral-200"
                  loading="lazy"
                />
                <p class="text-xs text-neutral-500 mt-1">公報第 {bulletin.sourcePage} 頁</p>
              </div>
            ) : bulletin.platformFormat === 'image' ? (
              <p class="text-neutral-500 text-sm">政見以圖片刊載，原圖處理中</p>
            ) : (
              <p class="text-neutral-500 text-sm">政見文字尚未整理</p>
            )}
          </div>

          {/* Education */}
          {bulletin.education && bulletin.education.length > 0 && (
            <div class="px-4 py-3">
              <h3 class="mb-2 text-sm font-semibold text-strong">學歷</h3>
              <ul class="text-sm text-neutral-800 space-y-0.5">
                {bulletin.education.map(item => (
                  <li>· {item}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Experience */}
          {bulletin.experience && bulletin.experience.length > 0 && (
            <div class="px-4 py-3">
              <h3 class="mb-2 text-sm font-semibold text-strong">經歷</h3>
              <ul class="text-sm text-neutral-800 space-y-0.5">
                {bulletin.experience.map(item => (
                  <li>· {item}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Declarations */}
          {bulletin.declarationsAsPrinted && bulletin.declarationsAsPrinted.length > 0 && (
            <div class="px-4 py-3">
              <h3 class="mb-2 text-sm font-semibold text-strong">具結情形</h3>
              <ul class="text-sm text-neutral-700 space-y-1">
                {bulletin.declarationsAsPrinted.map(decl => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-neutral-400">{decl.checked ? '✓' : '○'}</span>
                    <span>{decl.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Source Citation */}
          <div class="px-3 py-2 bg-neutral-50">
            <p class="text-xs text-neutral-500">
              來源：{bulletin.county}選委會公報第 {bulletin.sourcePage} 頁（{bulletin.asOf}）
              {bulletin.sourceArticleUrl && (
                <a href={bulletin.sourceArticleUrl} target="_blank" rel="noopener" class="underline ml-1">公告</a>
              )}
            </p>
          </div>
        </div>
      ) : (
        <div class="px-3 py-4 bg-neutral-50 text-sm text-neutral-600">
          <p class="font-medium">尚未整理</p>
          <p class="text-xs text-neutral-500 mt-1">
            選舉公報於 2026/11/25 前陸續公告。
            <a href="https://bulletin.cec.gov.tw/" target="_blank" rel="noopener" class="underline">中選會公報系統</a>
          </p>
        </div>
      )}
    </section>

    {/* Incumbent Performance - only for publish:true incumbents */}
    {incumbent && (
      <section class="space-y-2" aria-labelledby="incumbent-title">
        <div>
          <h2 id="incumbent-title" class="section-title">現任表現</h2>
          <p class="mt-1 text-sm text-secondary">
            指標格式為「該候選人／同選區現任者均值」。均值只納入該指標有數值的人，不作評分或排名。
          </p>
        </div>

        <div class="ui-card overflow-hidden p-0">
          <div class="border-b border-line bg-muted px-4 py-2">
            <h3 class="text-sm font-semibold text-strong">出席率（大會）</h3>
          </div>
          <div class="px-4 py-3">
            <MetricWithTooltip
              label="出席率（大會）"
              ratio={
                attendancePlenary != null
                  ? formatMetricRatio(attendancePlenary, districtAvg?.attendancePlenary ?? null, {
                      asPercent: true,
                    })
                  : '—/—'
              }
              tooltip={
                attendancePlenary != null
                  ? `分子：大會出席${attendanceCounts ? ` ${attendanceCounts.attended} 場／應出席 ${attendanceCounts.denominator} 場` : '率'}。分母：同選區（${candidate.districtOfficial || candidate.district || candidate.county}）有出席率資料的現任者平均（n=${districtAvg?.sampleSize.attendancePlenary ?? 0}）。請假與缺席留在分母；同一場兩份名單都有的場次已剔除。委員會未計算。`
                  : `目前無可用出席率數值。${attendanceLabel || '議會未公開可統計資料或尚未整理'}。分母同樣僅在有數值時計算。`
              }
              footnote={attendanceFootnote}
            />
          </div>
        </div>

        <div class="ui-card overflow-hidden p-0">
          <div class="border-b border-line bg-muted px-4 py-2">
            <h3 class="text-sm font-semibold text-strong">質詢</h3>
          </div>
          <div class="space-y-3 px-4 py-3">
            <MetricWithTooltip
              label="質詢數量"
              ratio={formatMetricRatio(
                interpellationCount,
                districtAvg?.interpellation ?? null,
                { digits: 1 }
              )}
              tooltip={`分子：此候選人質詢筆數${incumbent.interpellation?.kind ? `（${incumbent.interpellation.kind}）` : ''}。分母：同選區有質詢筆數的現任者平均（n=${districtAvg?.sampleSize.interpellation ?? 0}）。各議會公開格式不同，不宜跨縣市直接比較。`}
            />

            {(incumbent.interpellation?.term || incumbent.interpellation?.note) && (
              <p class="text-xs text-neutral-500">
                {incumbent.interpellation.term}
                {incumbent.interpellation.totalCountNote && (
                  <span class="ml-1">（{incumbent.interpellation.totalCountNote}）</span>
                )}
                {incumbent.interpellation.note && (
                  <span class={incumbent.interpellation.term ? 'ml-1' : ''}>
                    {incumbent.interpellation.note}
                  </span>
                )}
              </p>
            )}

            {interpellationList.length > 0 ? (
              <ExpandableRecordList items={interpellationList} initialCount={5} />
            ) : interpellationCount != null ? (
              <p class="text-sm text-neutral-600">共 {interpellationCount} 筆（明細尚未整理或僅有彙總）</p>
            ) : incumbent.interpellation?.status === 'missing' ? (
              <p class="text-sm text-neutral-500">
                {incumbent.interpellation.reason?.includes('未擷取')
                  ? '尚未整理'
                  : '議會未公開可統計資料'}
              </p>
            ) : (
              <p class="text-sm text-neutral-500">無公開明細</p>
            )}

            {incumbent.interpellation?.sourceUrl && (
              <a
                href={incumbent.interpellation.sourceUrl}
                target="_blank"
                rel="noopener"
                class="text-xs underline text-neutral-600 inline-block"
              >
                完整紀錄（議會官網）
              </a>
            )}
          </div>
        </div>

        <div class="ui-card overflow-hidden p-0">
          <div class="border-b border-line bg-muted px-4 py-2">
            <h3 class="text-sm font-semibold text-strong">提案</h3>
          </div>
          <div class="space-y-3 px-4 py-3">
            <MetricWithTooltip
              label="提案數量"
              ratio={formatMetricRatio(proposalCount, districtAvg?.proposals ?? null, { digits: 1 })}
              tooltip={`分子：此候選人提案筆數${incumbent.proposals?.kind === 'unspecified' ? '（議會未區分提案人／連署）' : '（以提案人計）'}。分母：同選區有提案筆數的現任者平均（n=${districtAvg?.sampleSize.proposals ?? 0}）。`}
              footnote={
                incumbent.proposals?.asCoSigner && (incumbent.proposals.asCoSigner.count ?? 0) > 0
                  ? `另有連署 ${incumbent.proposals.asCoSigner.count} 筆（不計入上方提案數量）`
                  : incumbent.proposals?.note || undefined
              }
            />

            {proposalList.length > 0 ? (
              <ExpandableRecordList items={proposalList} initialCount={5} />
            ) : proposalCount != null ? (
              <div class="text-sm text-neutral-600 space-y-1">
                <p>共 {proposalCount} 筆（明細尚未整理或僅有彙總）</p>
                {incumbent.proposals?.sourceUrl && (
                  <a
                    href={incumbent.proposals.sourceUrl}
                    target="_blank"
                    rel="noopener"
                    class="text-xs underline text-neutral-600 inline-block"
                  >
                    議會議決案目錄
                  </a>
                )}
                {incumbent.proposals?.asProposer?.sourceUrl && (
                  <a
                    href={incumbent.proposals.asProposer.sourceUrl}
                    target="_blank"
                    rel="noopener"
                    class="text-xs underline text-neutral-600 inline-block"
                  >
                    完整紀錄
                  </a>
                )}
              </div>
            ) : (
              <p class="text-sm text-neutral-500">無公開明細</p>
            )}
          </div>
        </div>

        <p class="text-xs text-secondary">
          {incumbent.incumbency.rosterSourceUrl && (
            <a href={incumbent.incumbency.rosterSourceUrl} target="_blank" rel="noopener" class="underline">
              {candidate.county}議會名冊
            </a>
          )}
          <span class="ml-2">原文照錄 · 均值由本站依同選區現任資料計算</span>
        </p>
      </section>
    )}

    <section class="ui-card overflow-hidden p-0" aria-labelledby="sources-title">
      <div class="border-b border-line bg-muted px-4 py-2">
        <h2 id="sources-title" class="text-sm font-semibold text-strong">資料來源</h2>
      </div>

      <ul class="divide-y divide-line text-sm">
        {candidate.sourceUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">候選人公告</span>
            <a href={candidate.sourceUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              {candidate.sourceDoc || '官方公告'}
            </a>
          </li>
        )}
        {candidate.registrationSourceUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">登記公告</span>
            <a href={candidate.registrationSourceUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              查看
            </a>
          </li>
        )}
        {candidate.drawSourceUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">號次抽籤</span>
            <a href={candidate.drawSourceUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              查看
            </a>
          </li>
        )}
        {candidate.sourceArticleUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">選委會公告</span>
            <a href={candidate.sourceArticleUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              查看
            </a>
          </li>
        )}
      </ul>
      
      <div class="border-t border-line bg-muted px-4 py-2">
        <p class="text-xs text-secondary">
          最後驗證：{candidate.lastVerified || candidate.asOf || '未記錄'}
        </p>
      </div>
    </section>

    <section class="ui-card" aria-labelledby="external-title">
      <h2 id="external-title" class="text-sm font-semibold text-strong">外部資源</h2>
      <ul class="mt-2 space-y-2 text-sm">
        <li>
          <a href="https://bulletin.cec.gov.tw/" target="_blank" rel="noopener" class="underline text-neutral-700">
            選舉公報查詢
          </a>
        </li>
        {(candidate.position === 'mayor-municipal' || candidate.position === 'mayor-county' || 
          candidate.position === 'councilor-municipal' || candidate.position === 'councilor-county') && (
          <li>
            <a href="https://pdps-dec.cec.gov.tw/release/formal/HomePage.html" target="_blank" rel="noopener" class="underline text-neutral-700">
              財產申報
            </a>
          </li>
        )}
        <li>
          <a href="https://info.cec.gov.tw/vote2026/" target="_blank" rel="noopener" class="underline text-neutral-700">
            中選會選舉專區
          </a>
        </li>
        <li>
          <a href="https://judgment.judicial.gov.tw/FJUD/default.aspx" target="_blank" rel="noopener" class="underline text-neutral-600">
            司法院裁判書查詢
          </a>
          <span class="text-neutral-400 text-xs ml-1">同名同姓請自行查證</span>
        </li>
      </ul>
    </section>

    {/* Evaluation Guide */}
    {position?.checkpoints && (
      <section class="ui-card" aria-labelledby="judge-title">
        <h2 id="judge-title" class="text-sm font-semibold text-strong">如何評估{shortName}候選人</h2>
        <ul class="mt-2 space-y-1 text-sm text-secondary">
          {position.checkpoints.slice(0, 4).map((checkpoint) => (
            <li>· {checkpoint}</li>
          ))}
        </ul>
        <a href={`${baseUrl}how-to-judge/`} class="mt-3 inline-flex min-h-11 items-center text-sm underline">
          完整指南
        </a>
      </section>
    )}

    {/* Disclaimer */}
    <p class="text-xs text-neutral-500 border-t border-neutral-200 pt-4">
      資料整理自官方公開來源，附有來源連結供查證。本站不提供評分、排名或比較。
    </p>

    {/* Report Error */}
    <div class="flex items-center gap-2 text-xs">
      <a href={reportMailto} class="text-neutral-600 underline hover:text-neutral-800">
        回報資料錯誤
      </a>
      <span class="text-neutral-400">以官方資料核對後修正</span>
    </div>

    <nav class="flex justify-between text-sm pt-4 border-t border-neutral-200">
      <a href={districtPageUrl} class="text-neutral-600 underline hover:text-neutral-800">
        ← 選區候選人
      </a>
      <a href={`${baseUrl}how-to-judge/`} class="text-neutral-600 underline hover:text-neutral-800">
        評估指南 →
      </a>
    </nav>
  </article>
</Layout>

<script>
  function bindMetricTips(root: ParentNode = document) {
    root.querySelectorAll<HTMLButtonElement>('[data-metric-tip]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const tipId = btn.getAttribute('aria-describedby');
        if (!tipId) return;
        const tip = document.getElementById(tipId);
        if (!tip) return;
        const open = tip.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  }

  function bindExpandableLists(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-expandable-list]').forEach((wrap) => {
      const btn = wrap.querySelector<HTMLButtonElement>('[data-expandable-toggle]');
      const rest = wrap.querySelector<HTMLElement>('[data-expandable-rest]');
      if (!btn || !rest || btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const willShow = rest.classList.contains('hidden');
        rest.classList.toggle('hidden', !willShow);
        btn.setAttribute('aria-expanded', willShow ? 'true' : 'false');
        btn.textContent = willShow ? '收合明細' : `展開其餘 ${rest.children.length} 則`;
      });
    });
  }

  bindMetricTips();
  bindExpandableLists();
  document.addEventListener('astro:page-load', () => {
    bindMetricTips();
    bindExpandableLists();
  });
</script>
