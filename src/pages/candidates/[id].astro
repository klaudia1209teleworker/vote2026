---
import Layout from '../../layouts/Layout.astro';
import candidates from '../../data/candidates.json';
import positions from '../../data/positions.json';

const baseUrl = import.meta.env.BASE_URL;

export function getStaticPaths() {
  function generateCandidateId(c: any): string {
    return `${c.county}-${c.position}-${c.district || c.districtOfficial || ''}-${c.name}`.replace(/[^a-zA-Z0-9\u4e00-\u9fff-]/g, '').toLowerCase();
  }
  
  const nonVillageChiefCandidates = (candidates as any[]).filter(c => c.position !== 'village-chief');
  
  return nonVillageChiefCandidates.map(candidate => ({
    params: { id: generateCandidateId(candidate) },
    props: { candidate }
  }));
}

const { candidate } = Astro.props;

const position = positions.positions.find(p => p.id === candidate.position);
const positionName = position?.name || candidate.position;
const shortName = position?.shortName || positionName;

function getStatusBadge(status: string, registeredOn?: string): { label: string; class: string; fullLabel: string } {
  const neutralClass = 'border border-neutral-300 bg-neutral-100 text-neutral-600';
  if (status.includes('公告候選人')) {
    return { label: '已公告', class: neutralClass, fullLabel: '正式候選人（選委會已公告）' };
  } else if (status.includes('已抽籤')) {
    return { label: '已抽籤', class: neutralClass, fullLabel: '已完成號次抽籤' };
  } else {
    const dateLabel = registeredOn ? ` (${registeredOn})` : '';
    return { label: '已登記', class: neutralClass, fullLabel: `已完成登記${dateLabel}` };
  }
}

function getPartyDisplay(party: string | null, partyAsListed: string | null): string {
  if (party) return party;
  if (partyAsListed === '無' || partyAsListed === null) return '無黨籍推薦';
  return partyAsListed;
}

const statusBadge = getStatusBadge(candidate.status, candidate.registeredOn);
const partyDisplay = getPartyDisplay(candidate.party, candidate.partyAsListed);

const districtPageUrl = (() => {
  const positionId = candidate.position;
  const city = candidate.county;
  
  if (positionId === 'mayor-municipal' || positionId === 'mayor-county') {
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'councilor-municipal' || positionId === 'councilor-county') {
    const districtName = candidate.districtOfficial || candidate.district;
    if (districtName) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(districtName)}/`;
    }
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'township-mayor' || positionId === 'township-representative') {
    const township = candidate.district;
    if (township) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(township)}/`;
    }
  }
  
  if (positionId === 'district-mayor' || positionId === 'district-representative') {
    const district = candidate.district;
    if (district) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(district)}/`;
    }
  }
  
  return `${baseUrl}candidates/`;
})();
---

<Layout title={`${candidate.name} - ${positionName}候選人`} description={`${candidate.county}${candidate.district || ''} ${positionName}候選人 ${candidate.name}`}>
  <article class="space-y-8">
    <header>
      <nav class="text-sm text-neutral-500 mb-4">
        <a href={`${baseUrl}candidates/`} class="hover:text-primary-600">候選人資訊</a>
        <span class="mx-2">›</span>
        <a href={districtPageUrl} class="hover:text-primary-600">{candidate.county} {candidate.districtOfficial || candidate.district || ''}</a>
        <span class="mx-2">›</span>
        <span class="text-neutral-700">{candidate.name}</span>
      </nav>
      
      <div class="flex flex-wrap items-start gap-4 mb-4">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2">
            {candidate.number != null && (
              <span class="text-3xl font-bold text-primary-600">{candidate.number}</span>
            )}
            <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800">
              {candidate.name}
            </h1>
          </div>
          <p class="text-neutral-600">
            {candidate.county} {candidate.districtOfficial || candidate.district || ''} · {positionName}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-neutral-100 text-neutral-700 rounded-full text-sm">
            {partyDisplay}
          </span>
          <span class={`px-3 py-1 rounded-full text-sm ${statusBadge.class}`}>
            {statusBadge.label}
          </span>
        </div>
      </div>
    </header>

    {/* Status Info */}
    <section class="p-4 bg-neutral-50 border border-neutral-200 rounded-lg">
      <h2 class="font-medium text-neutral-700 mb-2">📋 候選人狀態</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-neutral-500">目前狀態</dt>
          <dd class="text-neutral-800 font-medium">{statusBadge.fullLabel}</dd>
        </div>
        {candidate.registeredOn && (
          <div>
            <dt class="text-neutral-500">登記日期</dt>
            <dd class="text-neutral-800">{candidate.registeredOn}</dd>
          </div>
        )}
        {candidate.number != null && (
          <div>
            <dt class="text-neutral-500">號次</dt>
            <dd class="text-neutral-800 font-bold text-lg">{candidate.number} 號</dd>
          </div>
        )}
        <div>
          <dt class="text-neutral-500">政黨/推薦</dt>
          <dd class="text-neutral-800">{partyDisplay}</dd>
        </div>
      </dl>
    </section>

    {/* Data Sources */}
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">📎 資料來源</h2>
      
      <div class="space-y-4">
        {candidate.sourceUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">候選人公告</h3>
            <a 
              href={candidate.sourceUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              {candidate.sourceDoc || '選委會官方公告'} →
            </a>
            {candidate.asOf && (
              <p class="text-xs text-neutral-500 mt-1">公告日期：{candidate.asOf}</p>
            )}
          </div>
        )}
        
        {candidate.registrationSourceUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">登記公告</h3>
            <a 
              href={candidate.registrationSourceUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              登記結果公告 →
            </a>
            {candidate.registeredOn && (
              <p class="text-xs text-neutral-500 mt-1">登記日期：{candidate.registeredOn}</p>
            )}
          </div>
        )}
        
        {candidate.drawSourceUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">號次抽籤</h3>
            <a 
              href={candidate.drawSourceUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              抽籤結果公告 →
            </a>
          </div>
        )}
        
        {candidate.sourceArticleUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">選委會公告頁面</h3>
            <a 
              href={candidate.sourceArticleUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              選委會網站公告 →
            </a>
          </div>
        )}
      </div>
      
      <p class="text-xs text-neutral-500 mt-4">
        資料最後驗證：{candidate.lastVerified || candidate.asOf || '未記錄'}
      </p>
    </section>

    {/* Official Resources */}
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">🔗 官方資源</h2>
      
      <div class="grid gap-4 sm:grid-cols-2">
        <a 
          href="https://bulletin.cec.gov.tw/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
        >
          <p class="font-medium text-primary-700">選舉公報</p>
          <p class="text-sm text-primary-600">查看候選人完整政見</p>
        </a>
        
        {(candidate.position === 'mayor-municipal' || candidate.position === 'mayor-county' || 
          candidate.position === 'councilor-municipal' || candidate.position === 'councilor-county') && (
          <a 
            href="https://pdps-dec.cec.gov.tw/release/formal/HomePage.html" 
            target="_blank" 
            rel="noopener"
            class="p-4 bg-neutral-50 rounded-lg hover:bg-neutral-100 transition-colors"
          >
            <p class="font-medium text-neutral-700">財產申報</p>
            <p class="text-sm text-neutral-500">查看候選人財產申報</p>
          </a>
        )}
        
        <a 
          href="https://info.cec.gov.tw/vote2026/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-neutral-50 rounded-lg hover:bg-neutral-100 transition-colors"
        >
          <p class="font-medium text-neutral-700">中選會選舉專區</p>
          <p class="text-sm text-neutral-500">更多選舉資訊</p>
        </a>
      </div>
    </section>

    {/* Evaluation Guide */}
    <section class="p-6 bg-blue-50 border border-blue-200 rounded-xl">
      <h2 class="text-lg font-semibold text-blue-800 mb-3">
        🗳️ 如何評估{shortName}候選人？
      </h2>
      {position?.checkpoints && (
        <ul class="space-y-2 text-blue-700">
          {position.checkpoints.slice(0, 4).map((checkpoint) => (
            <li class="flex items-start gap-2">
              <span class="text-blue-500">•</span>
              <span>{checkpoint}</span>
            </li>
          ))}
        </ul>
      )}
      <a 
        href={`${baseUrl}how-to-judge/`}
        class="mt-4 inline-flex items-center gap-1 text-blue-600 hover:underline"
      >
        查看完整評估指南 →
      </a>
    </section>

    {/* Disclaimer */}
    <section class="p-4 bg-amber-50 border border-amber-200 rounded-lg">
      <p class="text-sm text-amber-700">
        <strong>⚠️ 資料說明：</strong>
        本頁資料整理自官方公開來源，所有數據皆附有來源連結供查證。
        如發現錯誤，歡迎提供官方來源協助修正。
        本站不提供候選人評分、排名或比較。
      </p>
    </section>

    <nav class="flex justify-between pt-8 border-t border-neutral-200">
      <a href={districtPageUrl} class="text-primary-600 hover:underline">
        ← 返回選區候選人
      </a>
      <a href={`${baseUrl}how-to-judge/`} class="text-primary-600 hover:underline">
        怎麼判斷候選人 →
      </a>
    </nav>
  </article>
</Layout>
