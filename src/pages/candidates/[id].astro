---
import Layout from '../../layouts/Layout.astro';
import candidates from '../../data/candidates.json';
import positions from '../../data/positions.json';
import bulletinData from '../../data/bulletin.json';
import incumbentsData from '../../data/incumbents.json';

const baseUrl = import.meta.env.BASE_URL;

type IncumbentInterpellationItem = {
  date?: string;
  dateAsRecorded?: string;
  time?: string;
  session?: string;
  department?: string;
  title?: string;
  councillorsAsRecorded?: string;
  listedAs?: string;
  sourceUrl?: string;
  videoUrl?: string;
  transcriptUrl?: string;
  documentUrl?: string;
};

type IncumbentEntry = {
  county: string;
  position: string;
  district: string;
  name: string;
  number: number;
  incumbency: {
    status: 'matched' | 'needsReview' | 'notFound';
    publish: boolean;
    rosterName?: string;
    rosterDistrict?: string;
    rosterSourceUrl?: string;
    profileUrl?: string;
    checkedOn?: string;
  };
  interpellation?: {
    status: 'available' | 'missing';
    kind?: string;
    term?: string;
    totalCount?: number;
    totalCountNote?: string;
    sourceUrl?: string;
    asOf?: string;
    reason?: string;
    items?: IncumbentInterpellationItem[];
  };
  attendance?: {
    status: 'available' | 'missing';
    reason?: string;
    checkedOn?: string;
  };
  proposals?: {
    status: 'available' | 'missing';
    reason?: string;
    checkedOn?: string;
  };
};

type BulletinEntry = {
  county: string;
  position: string;
  district: string;
  name: string;
  ballotNumber: number;
  platform: string;
  platformFormat: 'text' | 'image';
  education: string[];
  experience: string[];
  birthDateAsPrinted?: string;
  gender?: string;
  birthPlace?: string;
  partyAsPrinted?: string;
  declarationsAsPrinted?: { text: string; checked: boolean }[];
  sourceUrl?: string;
  sourcePage?: number;
  sourceArticleUrl?: string;
  asOf?: string;
};

function getBulletinKey(c: any): string {
  const district = c.district || c.county;
  return `${c.county}|${c.position}|${district}|${c.name}|${c.number ?? ''}`;
}

function getBulletinImagePath(entry: BulletinEntry): string | null {
  if (entry.platformFormat !== 'image' || !entry.sourceUrl || !entry.sourcePage) {
    return null;
  }
  const urlMatch = entry.sourceUrl.match(/\/([a-f0-9-]+)\.pdf$/i);
  if (!urlMatch) return null;
  const fileId = urlMatch[1].substring(0, 8);
  return `/bulletin-pages/${fileId}-p${entry.sourcePage}.webp`;
}

export function getStaticPaths() {
  function generateCandidateId(c: any): string {
    return `${c.county}-${c.position}-${c.district || c.districtOfficial || ''}-${c.name}`.replace(/[^a-zA-Z0-9\u4e00-\u9fff-]/g, '').toLowerCase();
  }
  
  const nonVillageChiefCandidates = (candidates as any[]).filter(c => c.position !== 'village-chief');
  
  return nonVillageChiefCandidates.map(candidate => ({
    params: { id: generateCandidateId(candidate) },
    props: { candidate }
  }));
}

const { candidate } = Astro.props;

const position = positions.positions.find(p => p.id === candidate.position);
const positionName = position?.name || candidate.position;
const shortName = position?.shortName || positionName;

function getStatusBadge(status: string, registeredOn?: string): { label: string; class: string; fullLabel: string } {
  const neutralClass = 'border border-neutral-300 bg-neutral-100 text-neutral-600';
  if (status.includes('公告候選人')) {
    return { label: '已公告', class: neutralClass, fullLabel: '正式候選人（選委會已公告）' };
  } else if (status.includes('已抽籤')) {
    return { label: '已抽籤', class: neutralClass, fullLabel: '已完成號次抽籤' };
  } else {
    const dateLabel = registeredOn ? ` (${registeredOn})` : '';
    return { label: '已登記', class: neutralClass, fullLabel: `已完成登記${dateLabel}` };
  }
}

function getPartyDisplay(party: string | null, partyAsListed: string | null): string {
  if (party) return party;
  if (partyAsListed === '無' || partyAsListed === null) return '無黨籍推薦';
  return partyAsListed;
}

const statusBadge = getStatusBadge(candidate.status, candidate.registeredOn);
const partyDisplay = getPartyDisplay(candidate.party, candidate.partyAsListed);

const bulletinKey = getBulletinKey(candidate);
const bulletin = (bulletinData as Record<string, BulletinEntry>)[bulletinKey] || null;
const bulletinImagePath = bulletin ? getBulletinImagePath(bulletin) : null;

const incumbentKey = bulletinKey;
const incumbentRaw = (incumbentsData as Record<string, IncumbentEntry>)[incumbentKey];
const incumbent = incumbentRaw?.incumbency?.publish ? incumbentRaw : null;

const districtPageUrl = (() => {
  const positionId = candidate.position;
  const city = candidate.county;
  
  if (positionId === 'mayor-municipal' || positionId === 'mayor-county') {
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'councilor-municipal' || positionId === 'councilor-county') {
    const districtName = candidate.districtOfficial || candidate.district;
    if (districtName) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(districtName)}/`;
    }
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'township-mayor' || positionId === 'township-representative') {
    const township = candidate.district;
    if (township) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(township)}/`;
    }
  }
  
  if (positionId === 'district-mayor' || positionId === 'district-representative') {
    const district = candidate.district;
    if (district) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(district)}/`;
    }
  }
  
  return `${baseUrl}candidates/`;
})();

const pageTitle = `${candidate.name} - ${positionName}候選人`;
const pageUrl = `https://klaudia1209teleworker.github.io/vote2026/candidates/${encodeURIComponent(candidate.county)}-${encodeURIComponent(candidate.position)}-${encodeURIComponent(candidate.district || candidate.districtOfficial || '')}-${encodeURIComponent(candidate.name)}/`;
const reportSubject = encodeURIComponent(`[勘誤] ${candidate.name}`);
const reportBody = encodeURIComponent(`頁面網址：${pageUrl}\n\n哪裡有錯：\n\n正確內容：\n\n官方來源連結：\n`);
const reportMailto = `mailto:kay-ycqbxw+vote2026@mail.grokbot.com?subject=${reportSubject}&body=${reportBody}`;
---

<Layout title={`${candidate.name} - ${positionName}候選人`} description={`${candidate.county}${candidate.district || ''} ${positionName}候選人 ${candidate.name}`}>
  <article class="space-y-8">
    <header>
      <nav class="text-sm text-neutral-500 mb-4">
        <a href={`${baseUrl}candidates/`} class="hover:text-primary-600">候選人資訊</a>
        <span class="mx-2">›</span>
        <a href={districtPageUrl} class="hover:text-primary-600">{candidate.county} {candidate.districtOfficial || candidate.district || ''}</a>
        <span class="mx-2">›</span>
        <span class="text-neutral-700">{candidate.name}</span>
      </nav>
      
      <div class="flex flex-wrap items-start gap-4 mb-4">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2">
            {candidate.number != null && (
              <span class="text-3xl font-bold text-primary-600">{candidate.number}</span>
            )}
            <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800">
              {candidate.name}
            </h1>
          </div>
          <p class="text-neutral-600">
            {candidate.county} {candidate.districtOfficial || candidate.district || ''} · {positionName}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {incumbent && (
            <span class="px-3 py-1 bg-neutral-200 text-neutral-700 rounded-full text-sm">
              現任議員
            </span>
          )}
          <span class="px-3 py-1 bg-neutral-100 text-neutral-700 rounded-full text-sm">
            {partyDisplay}
          </span>
          <span class={`px-3 py-1 rounded-full text-sm ${statusBadge.class}`}>
            {statusBadge.label}
          </span>
        </div>
      </div>
    </header>

    {/* Status Info */}
    <section class="p-4 bg-neutral-50 border border-neutral-200 rounded-lg">
      <h2 class="font-medium text-neutral-700 mb-2">📋 候選人狀態</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-neutral-500">目前狀態</dt>
          <dd class="text-neutral-800 font-medium">{statusBadge.fullLabel}</dd>
        </div>
        {candidate.registeredOn && (
          <div>
            <dt class="text-neutral-500">登記日期</dt>
            <dd class="text-neutral-800">{candidate.registeredOn}</dd>
          </div>
        )}
        {candidate.number != null && (
          <div>
            <dt class="text-neutral-500">號次</dt>
            <dd class="text-neutral-800 font-bold text-lg">{candidate.number} 號</dd>
          </div>
        )}
        <div>
          <dt class="text-neutral-500">政黨/推薦</dt>
          <dd class="text-neutral-800">{partyDisplay}</dd>
        </div>
      </dl>
    </section>

    {/* Election Bulletin Content */}
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">📜 選舉公報</h2>
      
      {bulletin ? (
        <div class="space-y-6">
          {/* Basic Info from Bulletin */}
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-3">基本資料（選舉公報刊載）</h3>
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
              {bulletin.birthDateAsPrinted && (
                <div>
                  <dt class="text-neutral-500">出生年月日</dt>
                  <dd class="text-neutral-800">{bulletin.birthDateAsPrinted}</dd>
                </div>
              )}
              {bulletin.gender && (
                <div>
                  <dt class="text-neutral-500">性別</dt>
                  <dd class="text-neutral-800">{bulletin.gender}</dd>
                </div>
              )}
              {bulletin.birthPlace && (
                <div>
                  <dt class="text-neutral-500">出生地</dt>
                  <dd class="text-neutral-800">{bulletin.birthPlace}</dd>
                </div>
              )}
              {bulletin.partyAsPrinted && (
                <div>
                  <dt class="text-neutral-500">推薦之政黨</dt>
                  <dd class="text-neutral-800">{bulletin.partyAsPrinted}</dd>
                </div>
              )}
            </dl>
          </div>

          {/* Platform */}
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-3">政見</h3>
            {bulletin.platformFormat === 'text' ? (
              <div class="text-neutral-800 whitespace-pre-wrap leading-relaxed font-sans text-sm sm:text-base">
                {bulletin.platform}
              </div>
            ) : bulletinImagePath ? (
              <div>
                <img 
                  src={`${baseUrl}${bulletinImagePath.substring(1)}`}
                  alt="選舉公報政見原圖"
                  class="max-w-full h-auto rounded border border-neutral-200"
                  loading="lazy"
                />
                <p class="text-xs text-neutral-500 mt-2">
                  選舉公報第 {bulletin.sourcePage} 頁政見原圖
                </p>
              </div>
            ) : (
              <p class="text-neutral-600 italic">政見以圖片形式刊載，原圖處理中</p>
            )}
          </div>

          {/* Education */}
          {bulletin.education && bulletin.education.length > 0 && (
            <div class="p-4 bg-neutral-50 rounded-lg">
              <h3 class="font-medium text-neutral-700 mb-3">學歷</h3>
              <ul class="space-y-1 text-neutral-800">
                {bulletin.education.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-neutral-400">•</span>
                    <span class="whitespace-pre-wrap">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Experience */}
          {bulletin.experience && bulletin.experience.length > 0 && (
            <div class="p-4 bg-neutral-50 rounded-lg">
              <h3 class="font-medium text-neutral-700 mb-3">經歷</h3>
              <ul class="space-y-1 text-neutral-800">
                {bulletin.experience.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-neutral-400">•</span>
                    <span class="whitespace-pre-wrap">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Declarations */}
          {bulletin.declarationsAsPrinted && bulletin.declarationsAsPrinted.length > 0 && (
            <div class="p-4 bg-neutral-50 rounded-lg">
              <h3 class="font-medium text-neutral-700 mb-3">具結情形</h3>
              <ul class="space-y-2 text-sm text-neutral-800">
                {bulletin.declarationsAsPrinted.map(decl => (
                  <li class="flex items-start gap-2">
                    <span class={`flex-shrink-0 w-5 h-5 flex items-center justify-center border rounded ${decl.checked ? 'bg-green-100 border-green-400 text-green-700' : 'bg-neutral-100 border-neutral-300 text-neutral-400'}`}>
                      {decl.checked ? '✓' : ''}
                    </span>
                    <span>{decl.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Source Citation */}
          <div class="pt-4 border-t border-neutral-200">
            <p class="text-xs text-neutral-500">
              資料來源：{bulletin.county}選委會選舉公報第 {bulletin.sourcePage} 頁（{bulletin.asOf}）
              {bulletin.sourceArticleUrl && (
                <a 
                  href={bulletin.sourceArticleUrl}
                  target="_blank"
                  rel="noopener"
                  class="ml-1 text-primary-600 hover:underline"
                >
                  [公告連結]
                </a>
              )}
            </p>
          </div>
        </div>
      ) : (
        <div class="p-4 bg-amber-50 rounded-lg border border-amber-200">
          <p class="text-amber-700">
            <strong>尚未整理</strong>
          </p>
          <p class="text-sm text-amber-600 mt-1">
            選舉公報將於 2026/11/25 前陸續公告。本站會在公報發布後盡速整理候選人政見資料。
          </p>
          <p class="text-xs text-amber-500 mt-2">
            您可前往
            <a 
              href="https://bulletin.cec.gov.tw/" 
              target="_blank" 
              rel="noopener"
              class="underline hover:text-amber-700"
            >
              中選會選舉公報查詢系統
            </a>
            查看最新公報。
          </p>
        </div>
      )}
    </section>

    {/* Incumbent Performance - only for publish:true incumbents */}
    {incumbent && (
      <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
        <h2 class="text-lg font-semibold text-neutral-800 mb-4">📊 現任表現</h2>
        
        <div class="space-y-6">
          {/* Interpellations */}
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-3">
              質詢紀錄
              {incumbent.interpellation?.kind && (
                <span class="ml-2 text-sm font-normal text-neutral-500">
                  （{incumbent.interpellation.kind}）
                </span>
              )}
            </h3>
            
            {incumbent.interpellation?.status === 'available' && incumbent.interpellation.items && incumbent.interpellation.items.length > 0 ? (
              <div class="space-y-4">
                {incumbent.interpellation.term && (
                  <p class="text-sm text-neutral-600">
                    {incumbent.interpellation.term}
                    {incumbent.interpellation.totalCount != null && (
                      <span>，共 {incumbent.interpellation.totalCount} 筆</span>
                    )}
                    {incumbent.interpellation.totalCountNote && (
                      <span class="text-neutral-400 ml-1">（{incumbent.interpellation.totalCountNote}）</span>
                    )}
                  </p>
                )}
                
                <ul class="space-y-3 text-sm">
                  {incumbent.interpellation.items.slice(0, 10).map(item => (
                    <li class="border-l-2 border-neutral-200 pl-3">
                      <div class="flex flex-wrap items-baseline gap-2">
                        {item.date && (
                          <span class="text-neutral-500">{item.date}</span>
                        )}
                        {item.time && (
                          <span class="text-neutral-400">{item.time}</span>
                        )}
                        {item.session && (
                          <span class="text-neutral-500">{item.session}</span>
                        )}
                      </div>
                      {item.title && (
                        <p class="text-neutral-800 mt-1">{item.title}</p>
                      )}
                      {item.listedAs && (
                        <p class="text-neutral-700 mt-1">{item.listedAs}</p>
                      )}
                      {item.department && (
                        <p class="text-neutral-500 text-xs mt-1">部門：{item.department}</p>
                      )}
                      <div class="flex flex-wrap gap-3 mt-2">
                        {item.videoUrl && (
                          <a href={item.videoUrl} target="_blank" rel="noopener" class="text-primary-600 hover:underline text-xs">
                            影音紀錄 →
                          </a>
                        )}
                        {item.transcriptUrl && (
                          <a href={item.transcriptUrl} target="_blank" rel="noopener" class="text-primary-600 hover:underline text-xs">
                            逐字稿 →
                          </a>
                        )}
                        {item.documentUrl && (
                          <a href={item.documentUrl} target="_blank" rel="noopener" class="text-primary-600 hover:underline text-xs">
                            質詢資料 PDF →
                          </a>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
                
                {incumbent.interpellation.items.length > 10 && (
                  <p class="text-xs text-neutral-500">
                    顯示前 10 筆，共 {incumbent.interpellation.items.length} 筆
                  </p>
                )}
                
                {incumbent.interpellation.sourceUrl && (
                  <a 
                    href={incumbent.interpellation.sourceUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-block text-sm text-primary-600 hover:underline mt-2"
                  >
                    完整紀錄（議會官網）→
                  </a>
                )}
              </div>
            ) : incumbent.interpellation?.status === 'missing' ? (
              <p class="text-neutral-500 text-sm">
                {incumbent.interpellation.reason?.includes('未擷取') ? '尚未整理' : '議會未公開可統計資料'}
              </p>
            ) : (
              <p class="text-neutral-500 text-sm">尚未整理</p>
            )}
          </div>

          {/* Attendance */}
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-3">出席率</h3>
            {incumbent.attendance?.status === 'available' ? (
              <p class="text-neutral-800">（資料處理中）</p>
            ) : (
              <p class="text-neutral-500 text-sm">
                {incumbent.attendance?.reason?.includes('未找到') ? '議會未公開可統計資料' : '尚未整理'}
              </p>
            )}
          </div>

          {/* Proposals */}
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-3">提案</h3>
            {incumbent.proposals?.status === 'available' ? (
              <p class="text-neutral-800">（資料處理中）</p>
            ) : (
              <p class="text-neutral-500 text-sm">
                {incumbent.proposals?.reason?.includes('未擷取') ? '尚未整理' : '議會未公開可統計資料'}
              </p>
            )}
          </div>

          {/* Source */}
          <div class="pt-4 border-t border-neutral-200">
            <p class="text-xs text-neutral-500">
              現任資料來源：
              {incumbent.incumbency.rosterSourceUrl && (
                <a 
                  href={incumbent.incumbency.rosterSourceUrl}
                  target="_blank"
                  rel="noopener"
                  class="text-primary-600 hover:underline"
                >
                  {incumbent.county}議會現任議員名冊
                </a>
              )}
              {incumbent.incumbency.checkedOn && (
                <span>（{incumbent.incumbency.checkedOn} 查核）</span>
              )}
            </p>
          </div>
        </div>
      </section>
    )}

    {/* Data Sources */}
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">📎 資料來源</h2>
      
      <div class="space-y-4">
        {candidate.sourceUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">候選人公告</h3>
            <a 
              href={candidate.sourceUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              {candidate.sourceDoc || '選委會官方公告'} →
            </a>
            {candidate.asOf && (
              <p class="text-xs text-neutral-500 mt-1">公告日期：{candidate.asOf}</p>
            )}
          </div>
        )}
        
        {candidate.registrationSourceUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">登記公告</h3>
            <a 
              href={candidate.registrationSourceUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              登記結果公告 →
            </a>
            {candidate.registeredOn && (
              <p class="text-xs text-neutral-500 mt-1">登記日期：{candidate.registeredOn}</p>
            )}
          </div>
        )}
        
        {candidate.drawSourceUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">號次抽籤</h3>
            <a 
              href={candidate.drawSourceUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              抽籤結果公告 →
            </a>
          </div>
        )}
        
        {candidate.sourceArticleUrl && (
          <div class="p-4 bg-neutral-50 rounded-lg">
            <h3 class="font-medium text-neutral-700 mb-2">選委會公告頁面</h3>
            <a 
              href={candidate.sourceArticleUrl}
              target="_blank"
              rel="noopener"
              class="text-primary-600 hover:underline break-all"
            >
              選委會網站公告 →
            </a>
          </div>
        )}
      </div>
      
      <p class="text-xs text-neutral-500 mt-4">
        資料最後驗證：{candidate.lastVerified || candidate.asOf || '未記錄'}
      </p>
    </section>

    {/* Official Resources */}
    <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
      <h2 class="text-lg font-semibold text-neutral-800 mb-4">🔗 官方資源</h2>
      
      <div class="grid gap-4 sm:grid-cols-2">
        <a 
          href="https://bulletin.cec.gov.tw/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
        >
          <p class="font-medium text-primary-700">選舉公報</p>
          <p class="text-sm text-primary-600">查看候選人完整政見</p>
        </a>
        
        {(candidate.position === 'mayor-municipal' || candidate.position === 'mayor-county' || 
          candidate.position === 'councilor-municipal' || candidate.position === 'councilor-county') && (
          <a 
            href="https://pdps-dec.cec.gov.tw/release/formal/HomePage.html" 
            target="_blank" 
            rel="noopener"
            class="p-4 bg-neutral-50 rounded-lg hover:bg-neutral-100 transition-colors"
          >
            <p class="font-medium text-neutral-700">財產申報</p>
            <p class="text-sm text-neutral-500">查看候選人財產申報</p>
          </a>
        )}
        
        <a 
          href="https://info.cec.gov.tw/vote2026/" 
          target="_blank" 
          rel="noopener"
          class="p-4 bg-neutral-50 rounded-lg hover:bg-neutral-100 transition-colors"
        >
          <p class="font-medium text-neutral-700">中選會選舉專區</p>
          <p class="text-sm text-neutral-500">更多選舉資訊</p>
        </a>
      </div>
      
      {/* Judicial Court Search */}
      <div class="mt-4 pt-4 border-t border-neutral-200">
        <a 
          href="https://judgment.judicial.gov.tw/FJUD/default.aspx"
          target="_blank"
          rel="noopener"
          class="text-neutral-600 hover:text-neutral-800 hover:underline text-sm"
        >
          司法院裁判書查詢（外部網站）→
        </a>
        <p class="text-xs text-neutral-400 mt-1">同名同姓請自行查證，本站不標註</p>
      </div>
    </section>

    {/* Evaluation Guide */}
    <section class="p-6 bg-blue-50 border border-blue-200 rounded-xl">
      <h2 class="text-lg font-semibold text-blue-800 mb-3">
        🗳️ 如何評估{shortName}候選人？
      </h2>
      {position?.checkpoints && (
        <ul class="space-y-2 text-blue-700">
          {position.checkpoints.slice(0, 4).map((checkpoint) => (
            <li class="flex items-start gap-2">
              <span class="text-blue-500">•</span>
              <span>{checkpoint}</span>
            </li>
          ))}
        </ul>
      )}
      <a 
        href={`${baseUrl}how-to-judge/`}
        class="mt-4 inline-flex items-center gap-1 text-blue-600 hover:underline"
      >
        查看完整評估指南 →
      </a>
    </section>

    {/* Disclaimer */}
    <section class="p-4 bg-amber-50 border border-amber-200 rounded-lg">
      <p class="text-sm text-amber-700">
        <strong>⚠️ 資料說明：</strong>
        本頁資料整理自官方公開來源，所有數據皆附有來源連結供查證。
        如發現錯誤，歡迎提供官方來源協助修正。
        本站不提供候選人評分、排名或比較。
      </p>
    </section>

    {/* Report Error */}
    <section class="flex flex-wrap items-center gap-3">
      <a 
        href={reportMailto}
        class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-100 border border-neutral-300 text-neutral-600 rounded-lg hover:bg-neutral-200 transition-colors text-sm"
      >
        ✉️ 回報資料錯誤
      </a>
      <span class="text-xs text-neutral-500">我們會以官方資料核對後修正</span>
    </section>

    <nav class="flex justify-between pt-8 border-t border-neutral-200">
      <a href={districtPageUrl} class="text-primary-600 hover:underline">
        ← 返回選區候選人
      </a>
      <a href={`${baseUrl}how-to-judge/`} class="text-primary-600 hover:underline">
        怎麼判斷候選人 →
      </a>
    </nav>
  </article>
</Layout>
