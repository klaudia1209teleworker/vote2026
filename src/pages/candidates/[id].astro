---
import Layout from '../../layouts/Layout.astro';
import candidates from '../../data/candidates.json';
import positions from '../../data/positions.json';
import bulletinData from '../../data/bulletin.json';
import incumbentsData from '../../data/incumbents.json';
import { getCandidateKey } from '../../utils/candidateKey';

const baseUrl = import.meta.env.BASE_URL;

type IncumbentInterpellationItem = {
  date?: string;
  dateAsRecorded?: string;
  time?: string;
  session?: string;
  department?: string;
  title?: string;
  councillorsAsRecorded?: string;
  listedAs?: string;
  sourceUrl?: string;
  videoUrl?: string;
  transcriptUrl?: string;
  documentUrl?: string;
};

type ProposalItem = {
  session?: string;
  title?: string;
  outcome?: Record<string, string | null>;
  sourceUrl?: string;
};

type IncumbentEntry = {
  incumbency: {
    publish: boolean;
    matchMethod?: string;
    rosterName?: string;
    rosterDistrict?: string;
    rosterNote?: string;
    rosterSourceUrl?: string;
    profileUrl?: string;
  };
  interpellation?: {
    kind?: string;
    count?: number;
    sourceUrl?: string;
    note?: string;
    items?: IncumbentInterpellationItem[];
  };
  proposals?: {
    kind?: string;
    note?: string;
    count?: number;
    sourceUrl?: string;
    asProposer?: {
      count?: number;
      sourceUrl?: string;
      items?: ProposalItem[];
    };
    asCoSigner?: {
      count?: number;
      sourceUrl?: string;
    };
  };
};

type BulletinEntry = {
  county: string;
  position: string;
  district: string;
  name: string;
  ballotNumber: number;
  platform: string;
  platformFormat: 'text' | 'image';
  education: string[];
  experience: string[];
  birthDateAsPrinted?: string;
  gender?: string;
  birthPlace?: string;
  partyAsPrinted?: string;
  declarationsAsPrinted?: { text: string; checked: boolean }[];
  sourceUrl?: string;
  sourcePage?: number;
  sourceArticleUrl?: string;
  asOf?: string;
};


function getBulletinImagePath(entry: BulletinEntry): string | null {
  if (entry.platformFormat !== 'image' || !entry.sourceUrl || !entry.sourcePage) {
    return null;
  }
  const urlMatch = entry.sourceUrl.match(/\/([a-f0-9-]+)\.pdf$/i);
  if (!urlMatch) return null;
  const fileId = urlMatch[1].substring(0, 8);
  return `/bulletin-pages/${fileId}-p${entry.sourcePage}.webp`;
}

export function getStaticPaths() {
  function generateCandidateId(c: any): string {
    return `${c.county}-${c.position}-${c.district || c.districtOfficial || ''}-${c.name}`.replace(/[^a-zA-Z0-9\u4e00-\u9fff-]/g, '').toLowerCase();
  }
  
  const nonVillageChiefCandidates = (candidates as any[]).filter(c => c.position !== 'village-chief');
  
  return nonVillageChiefCandidates.map(candidate => ({
    params: { id: generateCandidateId(candidate) },
    props: { candidate }
  }));
}

const { candidate } = Astro.props;

const position = positions.positions.find(p => p.id === candidate.position);
const positionName = position?.name || candidate.position;
const shortName = position?.shortName || positionName;

function getStatusBadge(status: string, registeredOn?: string): { label: string; class: string; fullLabel: string } | null {
  return null;
}

function getPartyDisplay(party: string | null, partyAsListed: string | null): string {
  if (party) return party;
  if (partyAsListed === '無' || partyAsListed === null) return '無黨籍推薦';
  return partyAsListed;
}

const statusBadge = getStatusBadge(candidate.status, candidate.registeredOn);
const partyDisplay = getPartyDisplay(candidate.party, candidate.partyAsListed);

const candidateKey = getCandidateKey(candidate);
const bulletin = (bulletinData as Record<string, BulletinEntry>)[candidateKey] || null;
const bulletinImagePath = bulletin ? getBulletinImagePath(bulletin) : null;

const incumbentKey = candidateKey;
const incumbentRaw = (incumbentsData as Record<string, IncumbentEntry>)[incumbentKey];
const incumbent = incumbentRaw?.incumbency?.publish ? incumbentRaw : null;

const districtPageUrl = (() => {
  const positionId = candidate.position;
  const city = candidate.county;
  
  if (positionId === 'mayor-municipal' || positionId === 'mayor-county') {
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'councilor-municipal' || positionId === 'councilor-county') {
    const districtName = candidate.districtOfficial || candidate.district;
    if (districtName) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(districtName)}/`;
    }
    return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/`;
  }
  
  if (positionId === 'township-mayor' || positionId === 'township-representative') {
    const township = candidate.district;
    if (township) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(township)}/`;
    }
  }
  
  if (positionId === 'district-mayor' || positionId === 'district-representative') {
    const district = candidate.district;
    if (district) {
      return `${baseUrl}candidates/district/${positionId}/${encodeURIComponent(city)}/${encodeURIComponent(district)}/`;
    }
  }
  
  return `${baseUrl}candidates/`;
})();

const pageTitle = `${candidate.name} - ${positionName}候選人`;
const pageUrl = `https://klaudia1209teleworker.github.io/vote2026/candidates/${encodeURIComponent(candidate.county)}-${encodeURIComponent(candidate.position)}-${encodeURIComponent(candidate.district || candidate.districtOfficial || '')}-${encodeURIComponent(candidate.name)}/`;
const reportSubject = encodeURIComponent(`[勘誤] ${candidate.name}`);
const reportBody = encodeURIComponent(`頁面網址：${pageUrl}\n\n哪裡有錯：\n\n正確內容：\n\n官方來源連結：\n`);
const reportMailto = `mailto:kay-ycqbxw+vote2026@mail.grokbot.com?subject=${reportSubject}&body=${reportBody}`;
---

<Layout title={`${candidate.name} - ${positionName}候選人`} description={`${candidate.county}${candidate.district || ''} ${positionName}候選人 ${candidate.name}`}>
  <article class="space-y-6">
    <header class="border-b border-neutral-200 pb-4">
      <nav class="text-xs text-neutral-500 mb-3">
        <a href={`${baseUrl}candidates/`} class="hover:underline">候選人</a>
        <span class="mx-1">/</span>
        <a href={districtPageUrl} class="hover:underline">{candidate.county} {candidate.districtOfficial || candidate.district || ''}</a>
        <span class="mx-1">/</span>
        <span class="text-neutral-700">{candidate.name}</span>
      </nav>
      
      <div class="flex items-baseline gap-3">
        {candidate.number != null && (
          <span class="text-xl font-semibold text-neutral-500 tabular-nums">{candidate.number}</span>
        )}
        <h1 class="text-xl font-semibold text-neutral-800">
          {candidate.name}
        </h1>
        {incumbent && (
          <span class="text-xs text-neutral-500 bg-neutral-100 px-1.5 py-0.5 rounded">現任</span>
        )}
      </div>
      <p class="text-sm text-neutral-500 mt-1">
        {candidate.county} {candidate.districtOfficial || candidate.district || ''} · {positionName} · {partyDisplay}
      </p>
    </header>

    {/* Status Info */}
    <section class="border border-neutral-200 rounded overflow-hidden">
      <table class="w-full text-sm">
        <tbody class="divide-y divide-neutral-100">
          {candidate.number != null && (
            <tr>
              <td class="px-3 py-2 text-neutral-500 w-24">號次</td>
              <td class="px-3 py-2 text-neutral-800 tabular-nums">{candidate.number} 號</td>
            </tr>
          )}
          <tr>
            <td class="px-3 py-2 text-neutral-500 w-24">政黨</td>
            <td class="px-3 py-2 text-neutral-800">{partyDisplay}</td>
          </tr>
          {candidate.registeredOn && (
            <tr>
              <td class="px-3 py-2 text-neutral-500 w-24">登記日期</td>
              <td class="px-3 py-2 text-neutral-800">{candidate.registeredOn}</td>
            </tr>
          )}
        </tbody>
      </table>
    </section>

    {/* Election Bulletin Content */}
    <section class="border border-neutral-200 rounded overflow-hidden">
      <div class="px-3 py-2 bg-neutral-50 border-b border-neutral-200">
        <h2 class="text-sm font-medium text-neutral-700">選舉公報</h2>
      </div>
      
      {bulletin ? (
        <div class="divide-y divide-neutral-100">
          {/* Basic Info from Bulletin */}
          <div class="px-3 py-3">
            <table class="w-full text-sm">
              <tbody>
                {bulletin.birthDateAsPrinted && (
                  <tr>
                    <td class="text-neutral-500 pr-4 py-0.5">出生年月日</td>
                    <td class="text-neutral-800">{bulletin.birthDateAsPrinted}</td>
                  </tr>
                )}
                {bulletin.gender && (
                  <tr>
                    <td class="text-neutral-500 pr-4 py-0.5">性別</td>
                    <td class="text-neutral-800">{bulletin.gender}</td>
                  </tr>
                )}
                {bulletin.birthPlace && (
                  <tr>
                    <td class="text-neutral-500 pr-4 py-0.5">出生地</td>
                    <td class="text-neutral-800">{bulletin.birthPlace}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          {/* Platform */}
          <div class="px-3 py-3">
            <h3 class="text-xs text-neutral-500 mb-2">政見</h3>
            {bulletin.platformFormat === 'text' ? (
              <div class="text-neutral-800 whitespace-pre-wrap text-sm leading-relaxed">
                {bulletin.platform}
              </div>
            ) : bulletinImagePath ? (
              <div>
                <img 
                  src={`${baseUrl}${bulletinImagePath.substring(1)}`}
                  alt="選舉公報政見原圖"
                  class="max-w-full h-auto border border-neutral-200"
                  loading="lazy"
                />
                <p class="text-xs text-neutral-500 mt-1">公報第 {bulletin.sourcePage} 頁</p>
              </div>
            ) : (
              <p class="text-neutral-500 text-sm">政見以圖片刊載，處理中</p>
            )}
          </div>

          {/* Education */}
          {bulletin.education && bulletin.education.length > 0 && (
            <div class="px-3 py-3">
              <h3 class="text-xs text-neutral-500 mb-2">學歷</h3>
              <ul class="text-sm text-neutral-800 space-y-0.5">
                {bulletin.education.map(item => (
                  <li>· {item}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Experience */}
          {bulletin.experience && bulletin.experience.length > 0 && (
            <div class="px-3 py-3">
              <h3 class="text-xs text-neutral-500 mb-2">經歷</h3>
              <ul class="text-sm text-neutral-800 space-y-0.5">
                {bulletin.experience.map(item => (
                  <li>· {item}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Declarations */}
          {bulletin.declarationsAsPrinted && bulletin.declarationsAsPrinted.length > 0 && (
            <div class="px-3 py-3">
              <h3 class="text-xs text-neutral-500 mb-2">具結情形</h3>
              <ul class="text-sm text-neutral-700 space-y-1">
                {bulletin.declarationsAsPrinted.map(decl => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-neutral-400">{decl.checked ? '✓' : '○'}</span>
                    <span>{decl.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Source Citation */}
          <div class="px-3 py-2 bg-neutral-50">
            <p class="text-xs text-neutral-500">
              來源：{bulletin.county}選委會公報第 {bulletin.sourcePage} 頁（{bulletin.asOf}）
              {bulletin.sourceArticleUrl && (
                <a href={bulletin.sourceArticleUrl} target="_blank" rel="noopener" class="underline ml-1">公告</a>
              )}
            </p>
          </div>
        </div>
      ) : (
        <div class="px-3 py-4 bg-neutral-50 text-sm text-neutral-600">
          <p class="font-medium">尚未整理</p>
          <p class="text-xs text-neutral-500 mt-1">
            選舉公報於 2026/11/25 前陸續公告。
            <a href="https://bulletin.cec.gov.tw/" target="_blank" rel="noopener" class="underline">中選會公報系統</a>
          </p>
        </div>
      )}
    </section>

    {/* Incumbent Performance - only for publish:true incumbents */}
    {incumbent && (
      <details class="border border-neutral-200 rounded" open>
        <summary class="px-3 py-2 cursor-pointer text-sm font-medium text-neutral-700 hover:bg-neutral-50 select-none">
          現任表現
        </summary>
        
        <div class="divide-y divide-neutral-100 border-t border-neutral-100">
          {/* Proposals */}
          <div class="px-3 py-3">
            <h3 class="text-xs text-neutral-500 mb-2">提案</h3>
            
            {incumbent.proposals?.kind === 'unspecified' ? (
              <div class="text-sm">
                <p class="text-neutral-700">{incumbent.proposals.count || 0} 筆</p>
                {incumbent.proposals.sourceUrl && (
                  <a href={incumbent.proposals.sourceUrl} target="_blank" rel="noopener" class="text-xs underline text-neutral-600">
                    議會議決案目錄
                  </a>
                )}
              </div>
            ) : incumbent.proposals?.asProposer || incumbent.proposals?.asCoSigner ? (
              <div class="text-sm space-y-2">
                {incumbent.proposals.asProposer && (
                  <div>
                    <p class="text-neutral-700">提案人 {incumbent.proposals.asProposer.count || 0} 筆</p>
                    {incumbent.proposals.asProposer.items && incumbent.proposals.asProposer.items.length > 0 && (
                      <ul class="mt-1 space-y-1 text-xs text-neutral-600">
                        {incumbent.proposals.asProposer.items.slice(0, 3).map(item => (
                          <li class="pl-2 border-l border-neutral-200">{item.title}</li>
                        ))}
                      </ul>
                    )}
                    {incumbent.proposals.asProposer.sourceUrl && (
                      <a href={incumbent.proposals.asProposer.sourceUrl} target="_blank" rel="noopener" class="text-xs underline text-neutral-600 mt-1 inline-block">
                        完整紀錄
                      </a>
                    )}
                  </div>
                )}
                {incumbent.proposals.asCoSigner && incumbent.proposals.asCoSigner.count > 0 && (
                  <p class="text-neutral-600">連署 {incumbent.proposals.asCoSigner.count} 筆</p>
                )}
              </div>
            ) : (
              <p class="text-neutral-500 text-sm">無公開資料</p>
            )}
          </div>

          {/* Interpellations */}
          <div class="px-3 py-3">
            <h3 class="text-xs text-neutral-500 mb-2">
              質詢{incumbent.interpellation?.kind && `（${incumbent.interpellation.kind}）`}
            </h3>
            
            {incumbent.interpellation?.items && incumbent.interpellation.items.length > 0 ? (
              <div class="text-sm">
                <p class="text-neutral-700">{incumbent.interpellation.count || incumbent.interpellation.items.length} 筆</p>
                <ul class="mt-1 space-y-1 text-xs text-neutral-600">
                  {incumbent.interpellation.items.slice(0, 3).map(item => (
                    <li class="pl-2 border-l border-neutral-200">
                      {item.date && <span class="text-neutral-400">{item.date} </span>}
                      {item.title || item.listedAs}
                    </li>
                  ))}
                </ul>
                {incumbent.interpellation.sourceUrl && (
                  <a href={incumbent.interpellation.sourceUrl} target="_blank" rel="noopener" class="text-xs underline text-neutral-600 mt-1 inline-block">
                    完整紀錄
                  </a>
                )}
              </div>
            ) : (
              <p class="text-neutral-500 text-sm">無公開資料</p>
            )}
          </div>

          {/* Source */}
          <div class="px-3 py-2 bg-neutral-50 text-xs text-neutral-500">
            {incumbent.incumbency.rosterSourceUrl && (
              <a href={incumbent.incumbency.rosterSourceUrl} target="_blank" rel="noopener" class="underline">
                {candidate.county}議會名冊
              </a>
            )}
            <span class="ml-2">原文照錄</span>
          </div>
        </div>
      </details>
    )}

    {/* Data Sources */}
    <section class="border border-neutral-200 rounded overflow-hidden">
      <div class="px-3 py-2 bg-neutral-50 border-b border-neutral-200">
        <h2 class="text-sm font-medium text-neutral-700">資料來源</h2>
      </div>
      
      <ul class="divide-y divide-neutral-100 text-sm">
        {candidate.sourceUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">候選人公告</span>
            <a href={candidate.sourceUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              {candidate.sourceDoc || '官方公告'}
            </a>
          </li>
        )}
        {candidate.registrationSourceUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">登記公告</span>
            <a href={candidate.registrationSourceUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              查看
            </a>
          </li>
        )}
        {candidate.drawSourceUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">號次抽籤</span>
            <a href={candidate.drawSourceUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              查看
            </a>
          </li>
        )}
        {candidate.sourceArticleUrl && (
          <li class="px-3 py-2 flex justify-between items-center">
            <span class="text-neutral-600">選委會公告</span>
            <a href={candidate.sourceArticleUrl} target="_blank" rel="noopener" class="underline text-neutral-700">
              查看
            </a>
          </li>
        )}
      </ul>
      
      <div class="px-3 py-2 bg-neutral-50 border-t border-neutral-100">
        <p class="text-xs text-neutral-500">
          最後驗證：{candidate.lastVerified || candidate.asOf || '未記錄'}
        </p>
      </div>
    </section>

    {/* Official Resources */}
    <section class="text-sm">
      <p class="text-xs text-neutral-500 mb-2">外部資源</p>
      <ul class="space-y-1">
        <li>
          <a href="https://bulletin.cec.gov.tw/" target="_blank" rel="noopener" class="underline text-neutral-700">
            選舉公報查詢
          </a>
        </li>
        {(candidate.position === 'mayor-municipal' || candidate.position === 'mayor-county' || 
          candidate.position === 'councilor-municipal' || candidate.position === 'councilor-county') && (
          <li>
            <a href="https://pdps-dec.cec.gov.tw/release/formal/HomePage.html" target="_blank" rel="noopener" class="underline text-neutral-700">
              財產申報
            </a>
          </li>
        )}
        <li>
          <a href="https://info.cec.gov.tw/vote2026/" target="_blank" rel="noopener" class="underline text-neutral-700">
            中選會選舉專區
          </a>
        </li>
        <li>
          <a href="https://judgment.judicial.gov.tw/FJUD/default.aspx" target="_blank" rel="noopener" class="underline text-neutral-600">
            司法院裁判書查詢
          </a>
          <span class="text-neutral-400 text-xs ml-1">同名同姓請自行查證</span>
        </li>
      </ul>
    </section>

    {/* Evaluation Guide */}
    {position?.checkpoints && (
      <details class="border border-neutral-200 rounded">
        <summary class="px-3 py-2 cursor-pointer text-sm font-medium text-neutral-700 hover:bg-neutral-50 select-none">
          如何評估{shortName}候選人
        </summary>
        <div class="px-3 py-2 border-t border-neutral-100">
          <ul class="text-sm text-neutral-600 space-y-1">
            {position.checkpoints.slice(0, 4).map((checkpoint) => (
              <li>· {checkpoint}</li>
            ))}
          </ul>
          <a href={`${baseUrl}how-to-judge/`} class="mt-2 inline-block text-xs underline text-neutral-600">
            完整指南
          </a>
        </div>
      </details>
    )}

    {/* Disclaimer */}
    <p class="text-xs text-neutral-500 border-t border-neutral-200 pt-4">
      資料整理自官方公開來源，附有來源連結供查證。本站不提供評分、排名或比較。
    </p>

    {/* Report Error */}
    <div class="flex items-center gap-2 text-xs">
      <a href={reportMailto} class="text-neutral-600 underline hover:text-neutral-800">
        回報資料錯誤
      </a>
      <span class="text-neutral-400">以官方資料核對後修正</span>
    </div>

    <nav class="flex justify-between text-sm pt-4 border-t border-neutral-200">
      <a href={districtPageUrl} class="text-neutral-600 underline hover:text-neutral-800">
        ← 選區候選人
      </a>
      <a href={`${baseUrl}how-to-judge/`} class="text-neutral-600 underline hover:text-neutral-800">
        評估指南 →
      </a>
    </nav>
  </article>
</Layout>
