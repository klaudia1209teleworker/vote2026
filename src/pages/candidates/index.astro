---
import Layout from '../../layouts/Layout.astro';
import DocFrame from '../../components/DocFrame.astro';
import candidates from '../../data/candidates.json';
import districts from '../../data/districts.json';
import positions from '../../data/positions.json';
import { cityHubPath, getCityCandidateNav, positionEntryPath } from '../../utils/cityCandidateNav';

const baseUrl = import.meta.env.BASE_URL;

const cityGroups = [
  { title: '直轄市（六都）', cities: districts.directMunicipalities.list },
  { title: '省轄市', cities: districts.provincialCities.list },
  { title: '縣', cities: districts.counties.list },
];

const positionCounts = (candidates as { position: string }[]).reduce((acc, candidate) => {
  acc[candidate.position] = (acc[candidate.position] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const totalCandidates = (candidates as unknown[]).length;

function getPositionName(positionId: string): string {
  const position = positions.positions.find((item) => item.id === positionId);
  return position?.shortName || position?.name || positionId;
}

const officialLinks = [
  {
    href: 'https://info.cec.gov.tw/vote2026/',
    title: '中選會選舉專區',
    note: '官方候選人查詢系統',
  },
  {
    href: 'https://bulletin.cec.gov.tw/',
    title: '選舉公報',
    note: '候選人完整政見',
  },
  {
    href: 'https://pdps-dec.cec.gov.tw/release/formal/HomePage.html',
    title: '財產申報查詢',
    note: '縣市長、縣市議員（不含基層）',
  },
  {
    href: 'https://journal.th.gov.tw/',
    title: '議事錄總庫',
    note: '現任議員質詢紀錄',
  },
];
---

<Layout title="候選人資訊" description="2026 九合一選舉各選區候選人資訊">
  <DocFrame groups={[{
    label: '快速導覽',
    items: [
      { href: '#cities', label: '依縣市查看' },
      { href: '#stats', label: '候選人統計' },
      { href: '#official', label: '官方查詢' },
      { href: '#detail', label: '詳細頁面' },
      { href: '#update', label: '資料更新' },
      { href: '#contribute', label: '貢獻資料' },
    ],
  }]}>
    <header>
      <h1 class="page-title">候選人資訊</h1>
      <p class="mt-2 text-secondary">
        已收錄 {totalCandidates.toLocaleString()} 位候選人，資料來自中選會及各縣市選委會官方公告。
        <a href={`${baseUrl}about/`} class="underline">來源清單與免責說明</a>
      </p>
    </header>

    <section id="cities" class="doc-anchor space-y-6">
      <div>
        <h2 class="section-title">依縣市查看</h2>
        <p class="mt-2 text-sm text-secondary">
          選擇縣市查看各職位候選人。也可以回到<a href={baseUrl} class="underline">首頁查詢選票</a>，直接連到對應選區。
        </p>
      </div>

      {cityGroups.map((group) => (
        <div>
          <h3 class="mb-3 text-sm font-semibold text-secondary">{group.title}</h3>
          <div class="grid gap-3 sm:grid-cols-2">
            {group.cities.map((city) => {
              const nav = getCityCandidateNav(city);
              return (
                <article class="ui-card">
                  <a href={`${baseUrl}${cityHubPath(city)}`} class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold text-strong">{city}</span>
                    <span class="text-sm text-secondary tabular-nums">{(nav?.total ?? 0).toLocaleString()} 人</span>
                  </a>
                  {nav && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {nav.positions.map((position) => (
                        <a
                          href={`${baseUrl}${positionEntryPath(city, position)}`}
                          class="rounded-md border border-line bg-muted px-2 py-1 text-xs text-ink hover:bg-hover"
                        >
                          {position.shortName}
                          <span class="text-secondary tabular-nums"> {position.count.toLocaleString()}</span>
                        </a>
                      ))}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </section>

    <section id="stats" class="ui-card doc-anchor">
      <h2 class="section-title">候選人統計</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {Object.entries(positionCounts).sort((a, b) => b[1] - a[1]).map(([positionId, count]) => (
          <div>
            <p class="text-2xl font-bold tabular-nums text-strong">{count.toLocaleString()}</p>
            <p class="text-sm text-secondary">{getPositionName(positionId)}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="official" class="doc-anchor">
      <h2 class="section-title mb-3">官方查詢</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {officialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="ui-card block">
            <p class="font-semibold text-strong">{link.title}</p>
            <p class="mt-1 text-sm text-secondary">{link.note}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="detail" class="ui-card doc-anchor">
      <h2 class="section-title">候選人詳細頁面</h2>
      <p class="mt-3 text-sm text-secondary">點候選人姓名可看詳細頁，內容依該人實際資料顯示：</p>
      <ul class="mt-3 space-y-1 text-sm text-secondary">
        <li>登記資料：姓名、號次、推薦政黨與選區</li>
        <li>選舉公報：政見與公報連結</li>
        <li>現任表現：有對到現任者時，顯示大會出席、提案與質詢</li>
        <li>資料來源與外部資源：官方文件、財產申報、議事錄</li>
      </ul>
      <p class="mt-3 text-xs text-secondary">
        村里長候選人共 {positionCounts['village-chief']?.toLocaleString() || '—'} 人，只提供列表，不另建個別詳細頁。
      </p>
    </section>

    <section id="update" class="ui-card doc-anchor">
      <h2 class="section-title">資料更新</h2>
      <p class="mt-3 text-sm text-secondary">
        資料來自中選會及各縣市選委會官方公告，會定期更新。最近一次更新：
        <time class="font-semibold text-ink tabular-nums" datetime="2026-11-15">2026-11-15</time>
      </p>
    </section>

    <section id="contribute" class="ui-card doc-anchor">
      <h2 class="section-title">如何貢獻資料</h2>
      <p class="mt-3 text-sm text-secondary">候選人資料以 JSON 儲存。補充時請依下列方式：</p>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-secondary">
        <li>參閱 <code class="rounded bg-muted px-1 py-0.5">src/data/candidates.json</code> 與 <code class="rounded bg-muted px-1 py-0.5">src/data/README.md</code></li>
        <li>只使用官方來源，例如選舉公報與議會紀錄</li>
        <li>每筆資料附 <code class="rounded bg-muted px-1 py-0.5">sourceUrl</code> 與相關日期</li>
        <li>提交 Pull Request，並寫明資料來源</li>
      </ol>
      <ul class="mt-4 space-y-1 border-t border-line pt-4 text-sm text-secondary">
        <li>不可捏造、推測，或使用非官方來源</li>
        <li>不可加入主觀評價、推薦或排名</li>
        <li>所有數據須能回溯到原始官方文件</li>
      </ul>
    </section>
  </DocFrame>
</Layout>
