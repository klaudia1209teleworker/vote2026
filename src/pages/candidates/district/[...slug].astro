---
import Layout from '../../../layouts/Layout.astro';
import candidates from '../../../data/candidates.json';
import positions from '../../../data/positions.json';
import districts from '../../../data/districts.json';
import electoralDistricts from '../../../data/electoralDistricts.json';
import incumbentsData from '../../../data/incumbents.json';
import { getCandidateKey } from '../../../utils/candidateKey';

const baseUrl = import.meta.env.BASE_URL;

type IncumbentEntry = {
  incumbency?: {
    publish?: boolean;
  };
};

function isIncumbent(c: any): boolean {
  const key = getCandidateKey(c);
  const entry = (incumbentsData as Record<string, IncumbentEntry>)[key];
  return entry?.incumbency?.publish === true;
}

export function getStaticPaths() {
  const paths: Array<{ params: { slug: string }, props: any }> = [];
  const allCities = Object.keys(districts.cities);
  
  const positionTypes = [
    { id: 'mayor-municipal', scope: 'city', cityTypes: ['直轄市'] },
    { id: 'mayor-county', scope: 'city', cityTypes: ['縣', '省轄市'] },
    { id: 'councilor-municipal', scope: 'electoral-district', cityTypes: ['直轄市'] },
    { id: 'councilor-county', scope: 'electoral-district', cityTypes: ['縣', '省轄市'] },
    { id: 'township-mayor', scope: 'township', cityTypes: ['縣'] },
    { id: 'township-representative', scope: 'township', cityTypes: ['縣'] },
    { id: 'district-mayor', scope: 'mountain-district', cityTypes: ['直轄市'] },
    { id: 'district-representative', scope: 'mountain-district', cityTypes: ['直轄市'] },
    { id: 'village-chief', scope: 'village', cityTypes: ['直轄市', '縣', '省轄市'] },
  ];
  
  for (const posType of positionTypes) {
    for (const city of allCities) {
      const cityData = districts.cities[city];
      if (!cityData || !posType.cityTypes.includes(cityData.type)) continue;
      
      if (posType.scope === 'city') {
        paths.push({
          params: { slug: `${posType.id}/${city}` },
          props: { 
            positionId: posType.id, 
            city, 
            district: null,
            township: null,
            scope: 'city'
          }
        });
      } else if (posType.scope === 'electoral-district' && posType.id.startsWith('councilor')) {
        const councilData = electoralDistricts.councilDistricts?.[city];
        if (councilData?.districts) {
          for (const dist of councilData.districts) {
            paths.push({
              params: { slug: `${posType.id}/${city}/${dist.name}` },
              props: {
                positionId: posType.id,
                city,
                district: dist.name,
                districtId: dist.id,
                township: null,
                scope: 'electoral-district',
                districtData: dist
              }
            });
          }
        }
        paths.push({
          params: { slug: `${posType.id}/${city}` },
          props: {
            positionId: posType.id,
            city,
            district: null,
            township: null,
            scope: 'city-councilor-index'
          }
        });
      } else if (posType.scope === 'township' && cityData.districts) {
        for (const township of cityData.districts) {
          paths.push({
            params: { slug: `${posType.id}/${city}/${township}` },
            props: {
              positionId: posType.id,
              city,
              district: null,
              township,
              scope: 'township'
            }
          });
        }
      } else if (posType.scope === 'mountain-district') {
        const mountainDistricts = districts.mountainIndigenousDistricts.list.filter(
          md => md.city === city
        );
        for (const md of mountainDistricts) {
          paths.push({
            params: { slug: `${posType.id}/${city}/${md.district}` },
            props: {
              positionId: posType.id,
              city,
              district: md.district,
              township: null,
              scope: 'mountain-district'
            }
          });
        }
      } else if (posType.scope === 'village' && cityData.districts) {
        for (const township of cityData.districts) {
          paths.push({
            params: { slug: `${posType.id}/${city}/${township}` },
            props: {
              positionId: posType.id,
              city,
              district: null,
              township,
              scope: 'village'
            }
          });
        }
      }
    }
  }
  
  return paths;
}

const { slug } = Astro.params;
const { positionId, city, district, township, scope, districtData } = Astro.props;

const position = positions.positions.find(p => p.id === positionId);
const positionName = position?.name || positionId;
const shortName = position?.shortName || positionName;

function getStatusBadge(status: string, registeredOn?: string): { label: string; class: string } | null {
  return null;
}

function getPartyDisplay(party: string | null, partyAsListed: string | null): string {
  if (party) return party;
  if (partyAsListed === '無' || partyAsListed === null) return '無黨籍推薦';
  return partyAsListed;
}

const isVillageChief = positionId === 'village-chief';

const candidatesForPage = (candidates as any[]).filter(c => {
  if (c.position !== positionId) return false;
  if (c.county !== city) return false;
  
  if (scope === 'electoral-district' && district) {
    return c.districtOfficial === district || c.district?.includes(district);
  }
  if (scope === 'township' && township) {
    return c.district === township;
  }
  if (scope === 'mountain-district' && district) {
    return c.district === district;
  }
  if (scope === 'village' && township) {
    return c.district?.startsWith(township) || c.district === township;
  }
  
  return true;
}).sort((a, b) => {
  if (a.number != null && b.number != null) return a.number - b.number;
  if (a.number != null) return -1;
  if (b.number != null) return 1;
  const dateA = a.registeredOn || '9999';
  const dateB = b.registeredOn || '9999';
  if (dateA !== dateB) return dateA.localeCompare(dateB);
  return a.name.localeCompare(b.name, 'zh-TW');
});

const hasCandidates = candidatesForPage.length > 0;

let pageTitle = '';
let pageDescription = '';
let locationLabel = city;

if (scope === 'city') {
  pageTitle = `${city}${shortName}候選人`;
  pageDescription = `${city}${positionName}候選人名單`;
  locationLabel = city;
} else if (scope === 'electoral-district') {
  pageTitle = `${city}${shortName}${district}候選人`;
  pageDescription = `${city}${positionName}${district}候選人名單`;
  locationLabel = `${city} ${district}`;
} else if (scope === 'city-councilor-index') {
  pageTitle = `${city}${shortName}選區一覽`;
  pageDescription = `${city}${positionName}各選區候選人名單連結`;
  locationLabel = city;
} else if (scope === 'township') {
  pageTitle = `${city}${township}${shortName}候選人`;
  pageDescription = `${city}${township}${positionName}候選人名單`;
  locationLabel = `${city} ${township}`;
} else if (scope === 'mountain-district') {
  pageTitle = `${city}${district}${shortName}候選人`;
  pageDescription = `${city}${district}${positionName}候選人名單`;
  locationLabel = `${city} ${district}`;
} else if (scope === 'village') {
  pageTitle = `${city}${township}村里長候選人`;
  pageDescription = `${city}${township}各里里長候選人名單`;
  locationLabel = `${city} ${township}`;
}

const councilDistrictsForCity = scope === 'city-councilor-index' 
  ? electoralDistricts.councilDistricts?.[city]?.districts || []
  : [];

const uniqueVillages = isVillageChief && scope === 'village'
  ? [...new Set(candidatesForPage.map(c => c.district))].sort((a, b) => a.localeCompare(b, 'zh-TW'))
  : [];

const latestAsOf = hasCandidates 
  ? candidatesForPage.reduce((latest, c) => {
      if (c.asOf && (!latest || c.asOf > latest)) return c.asOf;
      return latest;
    }, '')
  : '';

const pageUrl = `https://klaudia1209teleworker.github.io/vote2026/candidates/district/${slug}/`;
const reportSubject = encodeURIComponent(`[勘誤] ${pageTitle}`);
const reportBody = encodeURIComponent(`頁面網址：${pageUrl}\n\n哪裡有錯：\n\n正確內容：\n\n官方來源連結：\n`);
const reportMailto = `mailto:kay-ycqbxw+vote2026@mail.grokbot.com?subject=${reportSubject}&body=${reportBody}`;
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="space-y-6">
    <header>
      <nav class="text-sm text-neutral-500 mb-4">
        <a href={`${baseUrl}`} class="hover:text-primary-600">首頁</a>
        <span class="mx-2">›</span>
        <a href={`${baseUrl}candidates/`} class="hover:text-primary-600">候選人</a>
        <span class="mx-2">›</span>
        <span class="text-neutral-700">{locationLabel}</span>
      </nav>
      
      <h1 class="text-2xl sm:text-3xl font-bold text-neutral-800 mb-2">
        {pageTitle}
      </h1>
      
      {position && (
        <p class="text-neutral-600">
          <a href={`${baseUrl}positions/${positionId}/`} class="text-primary-600 hover:underline">
            {positionName}
          </a>
          {districtData?.seats && ` · 應選 ${districtData.seats} 名`}
          {hasCandidates && ` · 共 ${candidatesForPage.length} 位候選人`}
        </p>
      )}
    </header>

    {/* Data Disclaimer Banner */}
    {hasCandidates && (
      <div class="p-4 bg-neutral-100 border border-neutral-300 rounded-lg">
        <p class="text-neutral-700 text-sm">
          正式候選人名單以 11/17 中選會公告為準，本頁資料截至 {latestAsOf || '2026-11-15'}。
        </p>
      </div>
    )}

    {/* City Councilor Index - List All Districts */}
    {scope === 'city-councilor-index' && councilDistrictsForCity.length > 0 && (
      <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
        <h2 class="text-lg font-semibold text-neutral-800 mb-4">
          {city}{shortName}選區
        </h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {councilDistrictsForCity.map((dist) => (
            <a 
              href={`${baseUrl}candidates/district/${positionId}/${city}/${dist.name}/`}
              class="flex items-center justify-between p-4 bg-neutral-50 hover:bg-primary-50 border border-neutral-200 hover:border-primary-300 rounded-lg transition-colors"
            >
              <div>
                <span class="font-medium text-neutral-800">{dist.name}</span>
                {dist.seats && (
                  <span class="ml-2 text-sm text-neutral-500">應選 {dist.seats} 名</span>
                )}
                {dist.isIndigenous && (
                  <span class="ml-2 text-xs px-1.5 py-0.5 bg-purple-100 text-purple-700 rounded">
                    {dist.indigenousType === 'plains' ? '平地原住民' : '山地原住民'}
                  </span>
                )}
              </div>
              <span class="text-primary-600">→</span>
            </a>
          ))}
        </div>
        {councilDistrictsForCity.some(d => d.note) && (
          <p class="mt-4 text-sm text-neutral-500">
            * 部分選區依里劃分，詳見中選會公告
          </p>
        )}
      </section>
    )}

    {/* Village Chief with Village Filter */}
    {isVillageChief && scope === 'village' && hasCandidates && uniqueVillages.length > 1 && (
      <section class="p-4 bg-neutral-50 rounded-lg border border-neutral-200">
        <label for="village-filter" class="block text-sm font-medium text-neutral-700 mb-2">
          依村里篩選：
        </label>
        <select 
          id="village-filter" 
          class="w-full sm:w-auto px-3 py-2 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
        >
          <option value="">全部村里（{uniqueVillages.length} 個）</option>
          {uniqueVillages.map(v => (
            <option value={v}>{v}</option>
          ))}
        </select>
      </section>
    )}

    {/* Candidate List */}
    {scope !== 'city-councilor-index' && (
      <section class="p-6 bg-white rounded-xl shadow-sm border border-neutral-200">
        {hasCandidates ? (
          <div class="space-y-4" id="candidate-list">
            {isVillageChief && scope === 'village' ? (
              // Village Chief: Group by village
              uniqueVillages.map(village => {
                const villageCandidates = candidatesForPage.filter(c => c.district === village);
                return (
                  <div class="village-group" data-village={village}>
                    <h3 class="font-medium text-neutral-700 mb-3 pb-2 border-b border-neutral-200">
                      {village}
                      <span class="text-sm text-neutral-500 font-normal ml-2">
                        ({villageCandidates.length} 位候選人)
                      </span>
                    </h3>
                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mb-4">
                      {villageCandidates.map((candidate) => {
                        const statusBadge = getStatusBadge(candidate.status, candidate.registeredOn);
                        const partyDisplay = getPartyDisplay(candidate.party, candidate.partyAsListed);
                        const incumbent = isIncumbent(candidate);
                        return (
                          <div class="p-4 bg-neutral-50 border border-neutral-200 rounded-lg">
                            <div class="flex items-center gap-3 mb-2">
                              {candidate.number != null && (
                                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full font-bold text-sm">
                                  {candidate.number}
                                </span>
                              )}
                              <div class="min-w-0">
                                <p class="font-semibold text-neutral-800 truncate">
                                  {candidate.name}
                                  {incumbent && (
                                    <span class="ml-1.5 text-xs px-1.5 py-0.5 bg-neutral-200 text-neutral-600 rounded">現任</span>
                                  )}
                                </p>
                                <p class="text-xs text-neutral-500">
                                  {partyDisplay}
                                </p>
                              </div>
                            </div>
                            <div class="flex flex-wrap gap-2 items-center">
                              {statusBadge && (
                                <span class={`text-xs px-2 py-0.5 rounded ${statusBadge.class}`}>
                                  {statusBadge.label}
                                </span>
                              )}
                              {candidate.sourceUrl && (
                                <a 
                                  href={candidate.sourceUrl} 
                                  target="_blank" 
                                  rel="noopener"
                                  class="text-xs text-primary-600 hover:underline"
                                  title="官方來源"
                                >
                                  📄
                                </a>
                              )}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                );
              })
            ) : (
              // Non-village-chief: Regular list with links to detail pages
              candidatesForPage.map((candidate) => {
                const statusBadge = getStatusBadge(candidate.status, candidate.registeredOn);
                const partyDisplay = getPartyDisplay(candidate.party, candidate.partyAsListed);
                const incumbent = isIncumbent(candidate);
                const candidateId = `${candidate.county}-${candidate.position}-${candidate.district || candidate.districtOfficial || ''}-${candidate.name}`.replace(/[^a-zA-Z0-9\u4e00-\u9fff-]/g, '').toLowerCase();
                
                return (
                  <div class="flex items-start gap-4 p-4 bg-neutral-50 border border-neutral-200 rounded-lg">
                    {candidate.number != null && (
                      <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-primary-100 text-primary-700 rounded-full font-bold text-lg">
                        {candidate.number}
                      </span>
                    )}
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 flex-wrap mb-1">
                        <span class="font-semibold text-lg text-neutral-800">
                          {candidate.name}
                        </span>
                        {incumbent && (
                          <span class="text-xs px-2 py-0.5 bg-neutral-200 text-neutral-600 rounded">現任</span>
                        )}
                        <span class="text-sm px-2 py-0.5 bg-neutral-200 text-neutral-600 rounded">
                          {partyDisplay}
                        </span>
                        {statusBadge && (
                          <span class={`text-xs px-2 py-0.5 rounded ${statusBadge.class}`}>
                            {statusBadge.label}
                          </span>
                        )}
                      </div>
                      
                      {candidate.sourceUrl && (
                        <p class="text-xs text-neutral-500">
                          資料來源：
                          <a 
                            href={candidate.sourceUrl} 
                            target="_blank" 
                            rel="noopener" 
                            class="text-primary-600 hover:underline"
                          >
                            官方公告
                          </a>
                          {candidate.asOf && ` (${candidate.asOf})`}
                        </p>
                      )}
                    </div>
                    
                    <a 
                      href={`${baseUrl}candidates/${encodeURIComponent(candidateId)}/`}
                      class="flex-shrink-0 px-3 py-1.5 text-sm text-primary-600 border border-primary-200 rounded-md hover:bg-primary-50"
                    >
                      詳細 →
                    </a>
                  </div>
                );
              })
            )}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-5xl mb-4">📋</p>
            <p class="text-lg font-medium text-neutral-600 mb-2">
              此選區尚無候選人資料
            </p>
            <p class="text-neutral-500 mb-4">
              可能原因：登記尚未開始、無人登記參選、或資料尚待更新。
            </p>
            <div class="flex flex-wrap justify-center gap-3">
              <a 
                href="https://info.cec.gov.tw/vote2026/" 
                target="_blank" 
                rel="noopener"
                class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700"
              >
                前往中選會查詢
              </a>
            </div>
          </div>
        )}
      </section>
    )}

    {/* Source Info */}
    {hasCandidates && (
      <section id="sources" class="p-4 bg-neutral-50 border border-neutral-200 rounded-lg">
        <h3 class="font-medium text-neutral-700 mb-2">📎 資料來源說明</h3>
        <p class="text-sm text-neutral-600">
          本站資料整理自中選會及各縣市選委會官方公告，點擊「📄」圖示可查看原始來源。
        </p>
      </section>
    )}

    {/* Report Error */}
    <section class="flex flex-wrap items-center gap-3">
      <a 
        href={reportMailto}
        class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-100 border border-neutral-300 text-neutral-600 rounded-lg hover:bg-neutral-200 transition-colors text-sm"
      >
        ✉️ 回報資料錯誤
      </a>
      <span class="text-xs text-neutral-500">我們會以官方資料核對後修正</span>
    </section>

    {/* Voting Tips */}
    <section class="p-6 bg-blue-50 border border-blue-200 rounded-xl">
      <h2 class="text-lg font-semibold text-blue-800 mb-3">
        🗳️ 如何評估{shortName}候選人？
      </h2>
      {position?.checkpoints && (
        <ul class="space-y-2 text-blue-700">
          {position.checkpoints.slice(0, 4).map((checkpoint) => (
            <li class="flex items-start gap-2">
              <span class="text-blue-500">•</span>
              <span>{checkpoint}</span>
            </li>
          ))}
        </ul>
      )}
      <a 
        href={`${baseUrl}how-to-judge/`}
        class="mt-4 inline-flex items-center gap-1 text-blue-600 hover:underline"
      >
        查看完整評估指南 →
      </a>
    </section>

    {/* Navigation */}
    <nav class="flex flex-wrap justify-between gap-4 pt-6 border-t border-neutral-200">
      <a href={`${baseUrl}`} class="text-primary-600 hover:underline">
        ← 返回首頁重新查詢
      </a>
      <a href={`${baseUrl}positions/${positionId}/`} class="text-primary-600 hover:underline">
        了解{positionName}職責 →
      </a>
    </nav>
  </article>
</Layout>

{/* Village filter script */}
{isVillageChief && scope === 'village' && hasCandidates && (
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filter = document.getElementById('village-filter') as HTMLSelectElement;
      const groups = document.querySelectorAll('.village-group');
      
      if (filter && groups.length > 0) {
        filter.addEventListener('change', () => {
          const selected = filter.value;
          groups.forEach(group => {
            const village = (group as HTMLElement).dataset.village;
            if (!selected || village === selected) {
              (group as HTMLElement).style.display = '';
            } else {
              (group as HTMLElement).style.display = 'none';
            }
          });
        });
      }
    });
  </script>
)}
