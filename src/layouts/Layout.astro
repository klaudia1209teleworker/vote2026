---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '2026 九合一地方選舉候選人與選票查詢' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | 2026 九合一選舉</title>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-800">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-neutral-800 text-white px-3 py-1.5 text-sm rounded">
      跳至主要內容
    </a>
    
    <header class="bg-white border-b border-neutral-200 sticky top-0 z-50">
      <nav class="max-w-5xl mx-auto px-4 h-12 flex items-center justify-between">
        <a href={baseUrl} class="text-base font-semibold text-neutral-800 hover:text-neutral-600">
          2026 九合一選舉
        </a>
        
        <button 
          id="menu-toggle" 
          class="md:hidden p-1.5 -mr-1.5 text-neutral-600 hover:text-neutral-800"
          aria-label="開啟選單"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <ul id="nav-menu" class="hidden md:flex items-center gap-0.5 text-sm">
          <li><a href={baseUrl} class="px-2.5 py-1.5 rounded hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">首頁</a></li>
          <li><a href={`${baseUrl}positions/`} class="px-2.5 py-1.5 rounded hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">職務介紹</a></li>
          <li><a href={`${baseUrl}how-to-judge/`} class="px-2.5 py-1.5 rounded hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">判斷候選人</a></li>
          <li><a href={`${baseUrl}voting-day/`} class="px-2.5 py-1.5 rounded hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">投票須知</a></li>
          <li><a href={`${baseUrl}about/`} class="px-2.5 py-1.5 rounded hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">關於</a></li>
        </ul>
      </nav>
      
      <!-- Mobile menu -->
      <ul id="mobile-menu" class="hidden md:hidden px-4 pb-3 space-y-0.5 text-sm border-t border-neutral-100">
        <li><a href={baseUrl} class="block px-2.5 py-2 rounded hover:bg-neutral-100">首頁</a></li>
        <li><a href={`${baseUrl}positions/`} class="block px-2.5 py-2 rounded hover:bg-neutral-100">職務介紹</a></li>
        <li><a href={`${baseUrl}how-to-judge/`} class="block px-2.5 py-2 rounded hover:bg-neutral-100">判斷候選人</a></li>
        <li><a href={`${baseUrl}voting-day/`} class="block px-2.5 py-2 rounded hover:bg-neutral-100">投票須知</a></li>
        <li><a href={`${baseUrl}about/`} class="block px-2.5 py-2 rounded hover:bg-neutral-100">關於</a></li>
      </ul>
    </header>

    <main id="main-content" class="max-w-5xl mx-auto px-4 py-6">
      <slot />
    </main>

    <footer class="bg-neutral-800 text-neutral-400 mt-12 text-sm">
      <div class="max-w-5xl mx-auto px-4 py-6">
        <div class="space-y-3 text-center">
          <p class="text-neutral-300">
            本站非中央選舉委員會官方網站，資訊以
            <a href="https://www.cec.gov.tw/" target="_blank" rel="noopener noreferrer" class="underline hover:text-white">中選會公告</a>
            為準
          </p>
          <p class="text-neutral-500">
            投票日 2026/11/28（六）08:00–16:00 · 資料更新 2026-11-15
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      
      toggle?.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', (!isExpanded).toString());
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
