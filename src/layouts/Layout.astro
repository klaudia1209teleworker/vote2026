---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '2026 九合一地方選舉資訊網站 - 查詢您的選票、了解各職位職責、投票須知' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | 2026 九合一選舉</title>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-800">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary-600 text-white px-4 py-2 rounded">
      跳至主要內容
    </a>
    
    <header class="bg-white shadow-sm border-b border-neutral-200 sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <a href={baseUrl} class="text-lg font-semibold text-primary-700 hover:text-primary-800">
            🗳️ 2026 九合一選舉
          </a>
          
          <button 
            id="menu-toggle" 
            class="md:hidden p-2 text-neutral-600 hover:text-neutral-800"
            aria-label="開啟選單"
            aria-expanded="false"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <ul id="nav-menu" class="hidden md:flex items-center gap-1 text-sm">
            <li><a href={baseUrl} class="px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">首頁</a></li>
            <li><a href={`${baseUrl}positions/`} class="px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">職務介紹</a></li>
            <li><a href={`${baseUrl}how-to-judge/`} class="px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">怎麼判斷候選人</a></li>
            <li><a href={`${baseUrl}voting-day/`} class="px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">投票須知</a></li>
            <li><a href={`${baseUrl}cooperation/`} class="px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">合作案例</a></li>
            <li><a href={`${baseUrl}about/`} class="px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600 hover:text-neutral-800">關於</a></li>
          </ul>
        </div>
        
        <!-- Mobile menu -->
        <ul id="mobile-menu" class="hidden mt-4 pb-2 md:hidden space-y-1 text-sm border-t border-neutral-100 pt-4">
          <li><a href={baseUrl} class="block px-3 py-2 rounded-lg hover:bg-neutral-100">首頁</a></li>
          <li><a href={`${baseUrl}positions/`} class="block px-3 py-2 rounded-lg hover:bg-neutral-100">職務介紹</a></li>
          <li><a href={`${baseUrl}how-to-judge/`} class="block px-3 py-2 rounded-lg hover:bg-neutral-100">怎麼判斷候選人</a></li>
          <li><a href={`${baseUrl}voting-day/`} class="block px-3 py-2 rounded-lg hover:bg-neutral-100">投票須知</a></li>
          <li><a href={`${baseUrl}cooperation/`} class="block px-3 py-2 rounded-lg hover:bg-neutral-100">合作案例</a></li>
          <li><a href={`${baseUrl}about/`} class="block px-3 py-2 rounded-lg hover:bg-neutral-100">關於</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content" class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-neutral-800 text-neutral-300 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="text-center space-y-4">
          <p class="text-sm bg-yellow-900/30 text-yellow-200 px-4 py-2 rounded-lg inline-block">
            ⚠️ 本站非中央選舉委員會官方網站，所有資訊以
            <a href="https://www.cec.gov.tw/" target="_blank" rel="noopener noreferrer" class="underline hover:text-white">中選會官方公告</a>
            為準
          </p>
          <p class="text-sm text-neutral-400">
            投票日：2026 年 11 月 28 日（六）08:00 - 16:00
          </p>
          <p class="text-xs text-neutral-500">
            資料更新：2026-11-15 · 製作：Kay Chen
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      
      toggle?.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', (!isExpanded).toString());
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
