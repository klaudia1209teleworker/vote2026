---
import '../styles/global.css';
import { GA_MEASUREMENT_ID } from '../constants/analytics';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '2026 九合一地方選舉資訊：選票查詢、職務說明與候選人資料' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const navItems = [
  { href: baseUrl, label: '首頁', end: true },
  { href: `${baseUrl}positions/`, label: '職務介紹', end: false },
  { href: `${baseUrl}candidates/`, label: '候選人', end: false },
  { href: `${baseUrl}how-to-judge/`, label: '判斷候選人', end: false },
  { href: `${baseUrl}voting-day/`, label: '投票指南', end: false },
  { href: `${baseUrl}about/`, label: '關於', end: false },
];

const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const reportPageUrl = new URL(Astro.url.pathname, Astro.site).href;
const reportAddress = 'kay-ycqbxw+vote2026@mail.grokbot.com';

function reportMailto(kind: '勘誤' | '建議') {
  const subject = encodeURIComponent(`[${kind}] ${title}`);
  const body = kind === '勘誤'
    ? encodeURIComponent(`頁面網址：${reportPageUrl}\n\n哪裡有錯：\n\n正確內容：\n\n官方來源連結：\n`)
    : encodeURIComponent(`頁面網址：${reportPageUrl}\n\n建議內容：\n`);
  return `mailto:${reportAddress}?subject=${subject}&body=${body}`;
}

function isActive(href: string, end: boolean) {
  const target = href.endsWith('/') ? href : `${href}/`;
  if (end || target === baseUrl) return here === target;
  return here.startsWith(target);
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){dataLayer.push(arguments);}
      window.gtag('js', new Date());
      window.gtag('config', GA_MEASUREMENT_ID);
    </script>
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
    <title>{title} | 2026 台灣九合一地方選舉</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[70] btn btn-primary">
      跳至主要內容
    </a>

    <header class="site-header bg-surface border-b border-line sticky top-0 z-50">
      <div class="shell h-14 flex items-center">
        <a href={baseUrl} class="font-semibold text-strong tracking-tight">
          <span class="md:hidden">2026 九合一</span>
          <span class="hidden md:inline">2026 台灣九合一地方選舉</span>
        </a>

        <ul class="ml-auto hidden md:flex items-center">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', isActive(item.href, item.end) && 'is-active']}
                aria-current={isActive(item.href, item.end) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="site-nav-mobile md:hidden" aria-label="主要">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', isActive(item.href, item.end) && 'is-active']}
            aria-current={isActive(item.href, item.end) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a class="nav-link" href={`${baseUrl}#lookup`}>查詢選票</a>
      </nav>
    </header>

    <main id="main-content" class="shell py-5 md:py-6">
      <slot />
    </main>

    <footer class="border-t border-line bg-surface mt-10">
      <div class="shell py-6 text-sm">
        <h2 class="text-base font-semibold text-strong">
          資料來源（資料更新 <time class="tabular-nums font-semibold" datetime="2026-11-15">2026-11-15</time>｜<a href={`${baseUrl}about/`} class="underline">來源清單與免責說明</a>）
        </h2>
        <p class="mt-3 text-secondary">
          本站非中央選舉委員會官方網站。候選人、日期、投票規則與選舉結果以
          <a href="https://www.cec.gov.tw/" target="_blank" rel="noopener noreferrer" class="underline text-ink">中選會</a>
          及各地方選舉委員會正式公告為準；頁面上的 YouTube 影片是本網站知識架構的啟發來源，不代表創作者認可或背書本站，也不能取代官方公告。
        </p>
      </div>
    </footer>

    <details class="report-fab">
      <summary class="btn btn-primary">勘誤建議回報</summary>
      <div class="report-panel">
        <p class="report-panel-title">這則回報是</p>
        <a class="btn btn-secondary" href={reportMailto('勘誤')}>勘誤</a>
        <a class="btn btn-secondary" href={reportMailto('建議')}>建議</a>
      </div>
    </details>

    <script>
      document
        .querySelector('.site-nav-mobile a[aria-current="page"]')
        ?.scrollIntoView({ inline: 'center', block: 'nearest' });
    </script>
  </body>
</html>
