---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '2026 九合一地方選舉資訊：選票查詢、職務說明與候選人資料' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const navItems = [
  { href: baseUrl, label: '首頁', end: true },
  { href: `${baseUrl}positions/`, label: '職務介紹', end: false },
  { href: `${baseUrl}candidates/`, label: '候選人', end: false },
  { href: `${baseUrl}how-to-judge/`, label: '判斷候選人', end: false },
  { href: `${baseUrl}voting-day/`, label: '投票指南', end: false },
  { href: `${baseUrl}about/`, label: '關於', end: false },
];

const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

function isActive(href: string, end: boolean) {
  const target = href.endsWith('/') ? href : `${href}/`;
  if (end || target === baseUrl) return here === target;
  return here.startsWith(target);
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
    <title>{title} | 2026 台灣九合一地方選舉</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[70] btn btn-primary">
      跳至主要內容
    </a>

    <header class="bg-surface border-b border-line sticky top-0 z-50">
      <nav class="shell h-14 flex items-center gap-2" aria-label="主要">
        <a href={baseUrl} class="mr-auto font-semibold text-strong tracking-tight">
          <span class="md:hidden">2026 九合一</span>
          <span class="hidden md:inline">2026 台灣九合一地方選舉</span>
        </a>

        <ul class="hidden md:flex items-center">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', isActive(item.href, item.end) && 'is-active']}
                aria-current={isActive(item.href, item.end) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <button
          id="menu-toggle"
          type="button"
          class="icon-btn md:hidden"
          aria-label="開啟選單"
          aria-expanded="false"
          aria-controls="nav-drawer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </nav>
    </header>

    <div id="nav-drawer" class="nav-drawer md:hidden" hidden>
      <button type="button" class="nav-backdrop" data-close-nav aria-label="關閉選單"></button>
      <div class="nav-panel" role="dialog" aria-modal="true" aria-labelledby="nav-drawer-title">
        <div class="flex items-center justify-between mb-2">
          <p id="nav-drawer-title" class="px-3 font-semibold text-strong">選單</p>
          <button type="button" class="icon-btn" data-close-nav aria-label="關閉選單">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[isActive(item.href, item.end) && 'is-active']}
            aria-current={isActive(item.href, item.end) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a href={`${baseUrl}#lookup`}>查詢選票</a>
      </div>
    </div>

    <main id="main-content" class="shell py-5 md:py-6">
      <slot />
    </main>

    <footer class="border-t border-line bg-surface mt-10">
      <div class="shell py-6 flex flex-col gap-4 text-sm">
        <div class="space-y-3">
          <h2 class="text-base font-semibold text-strong">資料來源</h2>
          <p class="text-secondary">
            本站非中央選舉委員會官方網站。候選人、日期、投票規則與選舉結果以
            <a href="https://www.cec.gov.tw/" target="_blank" rel="noopener noreferrer" class="underline text-ink">中選會</a>
            及各地方選舉委員會正式公告為準。
          </p>
          <p class="text-secondary tabular-nums">投票日 2026-11-28（六）08:00–16:00</p>
          <p class="text-secondary tabular-nums">資料更新 2026-11-15</p>
        </div>
        <div class="space-y-3">
          <p class="text-secondary">
            頁面上的 YouTube 影片是知識架構的啟發來源，不代表創作者認可或背書本站，也不能取代官方公告。
          </p>
          <p>
            <a href={`${baseUrl}about/`} class="underline text-ink">來源清單與免責說明</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const drawer = document.getElementById('nav-drawer');
      const panel = drawer?.querySelector('.nav-panel');

      function setOpen(open: boolean) {
        if (!toggle || !drawer) return;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
        drawer.hidden = !open;
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) {
          panel?.querySelector<HTMLElement>('a, button')?.focus();
        }
      }

      toggle?.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      drawer?.querySelectorAll('[data-close-nav]').forEach((button) => {
        button.addEventListener('click', () => {
          setOpen(false);
          toggle?.focus();
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && drawer && !drawer.hidden) {
          setOpen(false);
          toggle?.focus();
        }
      });
    </script>
  </body>
</html>
