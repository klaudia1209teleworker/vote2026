---
interface Item {
  href: string;
  label: string;
  current?: boolean;
}

interface Group {
  label: string;
  items: Item[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props;
---

<div class="doc-layout">
  <nav class="doc-nav ui-card" aria-label="頁面導覽">
    {groups.map((group) => (
      <div class="doc-nav-group">
        <p class="doc-nav-label">{group.label}</p>
        {group.items.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[item.current && 'is-current']}
          >
            {item.label}
          </a>
        ))}
      </div>
    ))}
  </nav>
  <div class="doc-main space-y-6">
    <slot />
  </div>
</div>
