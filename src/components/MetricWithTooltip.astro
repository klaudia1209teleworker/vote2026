---
interface Props {
  label: string;
  ratio: string;
  tooltip: string;
  footnote?: string;
}

const { label, ratio, tooltip, footnote } = Astro.props;
const tipId = `tip-${label.replace(/\s+/g, '-')}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="space-y-1">
  <div class="flex items-baseline justify-between gap-3">
    <div class="flex items-center gap-1.5 min-w-0">
      <span class="text-xs text-neutral-500">{label}</span>
      <button
        type="button"
        class="metric-tip-btn"
        aria-describedby={tipId}
        aria-expanded="false"
        data-metric-tip
      >
        <svg class="metric-tip-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle class="metric-tip-ring" cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.25" />
          <path class="metric-tip-mark" d="M8 7.15V11" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
          <circle class="metric-tip-dot" cx="8" cy="4.85" r="0.75" fill="currentColor" />
        </svg>
        <span class="sr-only">{label}說明</span>
      </button>
    </div>
    <span class="text-sm tabular-nums text-neutral-800 font-medium" title={tooltip}>{ratio}</span>
  </div>
  <p id={tipId} class="metric-tip hidden text-xs text-neutral-500 leading-relaxed" role="tooltip">
    {tooltip}
  </p>
  {footnote && (
    <p class="text-xs text-neutral-500">{footnote}</p>
  )}
</div>
