---
import districts from '../data/districts.json';
import ballotRules from '../data/ballotRules.json';
import electoralDistricts from '../data/electoralDistricts.json';

const cities = Object.keys(districts.cities);
const directMunicipalities = districts.directMunicipalities.list;
const provincialCities = districts.provincialCities.list;
const mountainIndigenousDistricts = districts.mountainIndigenousDistricts.list;
const baseUrl = import.meta.env.BASE_URL;
---

<div class="bg-white border border-neutral-200 rounded p-4 sm:p-5">
  <h2 class="text-base font-semibold text-neutral-800 mb-4">
    查詢選票
  </h2>
  
  <form id="ballot-form" class="space-y-4">
    <!-- Step 1: Select City -->
    <div>
      <label for="city-select" class="block text-sm text-neutral-700 mb-1.5">
        戶籍所在縣市
      </label>
      <select 
        id="city-select" 
        name="city"
        class="w-full px-3 py-2 border border-neutral-300 rounded text-sm focus:outline-none focus:border-neutral-500"
        required
      >
        <option value="">選擇縣市</option>
        <optgroup label="直轄市（六都）">
          {directMunicipalities.map(city => (
            <option value={city}>{city}</option>
          ))}
        </optgroup>
        <optgroup label="省轄市">
          {provincialCities.map(city => (
            <option value={city}>{city}</option>
          ))}
        </optgroup>
        <optgroup label="縣">
          {districts.counties.list.map(city => (
            <option value={city}>{city}</option>
          ))}
        </optgroup>
      </select>
    </div>

    <!-- Step 2: Select District -->
    <div id="district-section" class="hidden">
      <label for="district-select" class="block text-sm text-neutral-700 mb-1.5">
        鄉鎮市區
      </label>
      <select 
        id="district-select" 
        name="district"
        class="w-full px-3 py-2 border border-neutral-300 rounded text-sm focus:outline-none focus:border-neutral-500"
      >
        <option value="">選擇鄉鎮市區</option>
      </select>
      <p id="district-note" class="mt-1.5 text-xs text-neutral-500 hidden">
        部分選區依村里劃分，可能需進一步確認
      </p>
    </div>

    <!-- Step 2.5: Select Electoral District for split townships -->
    <div id="electoral-district-section" class="hidden">
      <label class="block text-sm text-neutral-700 mb-1.5">
        議員選區（此鄉鎮市區依村里劃分）
      </label>
      <div id="electoral-district-options" class="space-y-1.5">
        <!-- Options will be inserted here -->
      </div>
      <p class="mt-2 text-xs text-neutral-500">
        依戶籍地址中的「里」選擇，或查 <a href="https://info.cec.gov.tw/vote2026/" target="_blank" rel="noopener" class="underline">中選會官網</a>
      </p>
    </div>

    <!-- Step 3: Indigenous Status -->
    <div id="indigenous-section" class="hidden">
      <label class="block text-sm text-neutral-700 mb-1.5">
        原住民身分
      </label>
      <div class="flex flex-wrap gap-2">
        <label class="flex items-center gap-2 px-3 py-1.5 border border-neutral-200 rounded cursor-pointer hover:bg-neutral-50 has-[:checked]:border-neutral-400 has-[:checked]:bg-neutral-100 text-sm">
          <input type="radio" name="indigenous" value="none" class="w-3.5 h-3.5" checked />
          <span>無</span>
        </label>
        <label class="flex items-center gap-2 px-3 py-1.5 border border-neutral-200 rounded cursor-pointer hover:bg-neutral-50 has-[:checked]:border-neutral-400 has-[:checked]:bg-neutral-100 text-sm">
          <input type="radio" name="indigenous" value="plains" class="w-3.5 h-3.5" />
          <span>平地原住民</span>
        </label>
        <label class="flex items-center gap-2 px-3 py-1.5 border border-neutral-200 rounded cursor-pointer hover:bg-neutral-50 has-[:checked]:border-neutral-400 has-[:checked]:bg-neutral-100 text-sm">
          <input type="radio" name="indigenous" value="mountain" class="w-3.5 h-3.5" />
          <span>山地原住民</span>
        </label>
      </div>
    </div>

    <!-- Submit -->
    <div id="submit-section" class="hidden">
      <button 
        type="submit" 
        class="px-4 py-2 bg-neutral-800 text-white text-sm font-medium rounded hover:bg-neutral-700"
      >
        查詢
      </button>
    </div>
  </form>

  <!-- Results -->
  <div id="ballot-results" class="hidden mt-5 pt-5 border-t border-neutral-200">
    <h3 class="text-sm font-semibold text-neutral-800 mb-3">
      選票一覽
    </h3>
    <div id="results-content" class="space-y-3">
      <!-- Results will be inserted here -->
    </div>
  </div>
</div>

<script define:vars={{ districts, ballotRules, mountainIndigenousDistricts, directMunicipalities, provincialCities, electoralDistricts, baseUrl }}>
  const citySelect = document.getElementById('city-select');
  const districtSelect = document.getElementById('district-select');
  const districtSection = document.getElementById('district-section');
  const districtNote = document.getElementById('district-note');
  const electoralDistrictSection = document.getElementById('electoral-district-section');
  const electoralDistrictOptions = document.getElementById('electoral-district-options');
  const indigenousSection = document.getElementById('indigenous-section');
  const submitSection = document.getElementById('submit-section');
  const form = document.getElementById('ballot-form');
  const resultsSection = document.getElementById('ballot-results');
  const resultsContent = document.getElementById('results-content');
  
  let selectedElectoralDistrict = null;

  function getCouncilorMapping(city, adminDistrict, positionId) {
    return electoralDistricts.adminToElectoralMapping?.[positionId]?.[city]?.[adminDistrict];
  }

  function getCouncilorDistrictUrl(city, adminDistrict, positionId, indigenousType, explicitDistrictName) {
    if (explicitDistrictName) {
      return `${baseUrl}candidates/district/${positionId}/${city}/${explicitDistrictName}/`;
    }
    const mapping = getCouncilorMapping(city, adminDistrict, positionId);
    if (mapping && !mapping.isSplit) {
      return `${baseUrl}candidates/district/${positionId}/${city}/${mapping.districtName}/`;
    }
    if (indigenousType === 'plains') {
      return `${baseUrl}candidates/district/${positionId}/${city}/平地原住民選區/`;
    }
    if (indigenousType === 'mountain') {
      return `${baseUrl}candidates/district/${positionId}/${city}/山地原住民選區/`;
    }
    return `${baseUrl}candidates/district/${positionId}/${city}/`;
  }

  function getIndigenousCouncilorDistricts(city, positionId) {
    const councilData = electoralDistricts.councilDistricts?.[city];
    if (!councilData) return { plains: null, mountain: null };
    
    const plainsDistrict = councilData.districts?.find(d => d.isIndigenous && d.indigenousType === 'plains');
    const mountainDistrict = councilData.districts?.find(d => d.isIndigenous && d.indigenousType === 'mountain');
    
    return {
      plains: plainsDistrict ? {
        name: plainsDistrict.name,
        url: `${baseUrl}candidates/district/${positionId}/${city}/${plainsDistrict.name}/`
      } : null,
      mountain: mountainDistrict ? {
        name: mountainDistrict.name,
        url: `${baseUrl}candidates/district/${positionId}/${city}/${mountainDistrict.name}/`
      } : null
    };
  }

  function updateElectoralDistrictSection(city, adminDistrict, positionId) {
    const mapping = getCouncilorMapping(city, adminDistrict, positionId);
    
    if (!mapping || !mapping.isSplit) {
      electoralDistrictSection.classList.add('hidden');
      selectedElectoralDistrict = mapping ? mapping.districtName : null;
      return;
    }
    
    selectedElectoralDistrict = null;
    
    const optionsHtml = mapping.districts.map((d, i) => `
      <label class="flex items-center gap-2 px-3 py-2 border border-neutral-200 rounded cursor-pointer hover:bg-neutral-50 has-[:checked]:border-neutral-400 has-[:checked]:bg-neutral-100 text-sm">
        <input type="radio" name="electoral-district" value="${d.districtName}" class="w-3.5 h-3.5" />
        <span class="font-medium">${d.districtName}</span>
        <span class="text-neutral-500">（${d.seats} 名）</span>
        ${d.note ? `<span class="text-neutral-400 text-xs ml-1">${d.note}</span>` : ''}
      </label>
    `).join('');
    
    electoralDistrictOptions.innerHTML = optionsHtml;
    electoralDistrictSection.classList.remove('hidden');
    
    electoralDistrictOptions.querySelectorAll('input[name="electoral-district"]').forEach(input => {
      input.addEventListener('change', () => {
        selectedElectoralDistrict = input.value;
      });
    });
  }

  citySelect.addEventListener('change', () => {
    const city = citySelect.value;
    if (!city) {
      districtSection.classList.add('hidden');
      electoralDistrictSection.classList.add('hidden');
      indigenousSection.classList.add('hidden');
      submitSection.classList.add('hidden');
      resultsSection.classList.add('hidden');
      return;
    }

    const cityData = districts.cities[city];
    if (cityData && cityData.districts) {
      districtSelect.innerHTML = '<option value="">請選擇鄉鎮市區</option>' +
        cityData.districts.map(d => `<option value="${d}">${d}</option>`).join('');
      districtSection.classList.remove('hidden');
      
      if (cityData.notes) {
        districtNote.textContent = `⚠️ ${cityData.notes}`;
        districtNote.classList.remove('hidden');
      } else {
        districtNote.classList.add('hidden');
      }
    }
    
    electoralDistrictSection.classList.add('hidden');
    selectedElectoralDistrict = null;
    indigenousSection.classList.remove('hidden');
    submitSection.classList.remove('hidden');
    resultsSection.classList.add('hidden');
  });

  districtSelect.addEventListener('change', () => {
    const city = citySelect.value;
    const adminDistrict = districtSelect.value;
    
    if (!city || !adminDistrict) {
      electoralDistrictSection.classList.add('hidden');
      selectedElectoralDistrict = null;
      return;
    }
    
    const positionId = directMunicipalities.includes(city) ? 'councilor-municipal' : 'councilor-county';
    updateElectoralDistrictSection(city, adminDistrict, positionId);
    resultsSection.classList.add('hidden');
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const city = citySelect.value;
    const district = districtSelect.value;
    const indigenous = document.querySelector('input[name="indigenous"]:checked').value;
    
    if (!city) return;
    
    const positionId = directMunicipalities.includes(city) ? 'councilor-municipal' : 'councilor-county';
    const mapping = district ? getCouncilorMapping(city, district, positionId) : null;
    
    if (district && mapping && mapping.isSplit && !selectedElectoralDistrict) {
      alert('請先選擇您的戶籍里所屬的議員選區');
      return;
    }
    
    const ballots = [];
    const cityData = districts.cities[city];
    const cityType = cityData?.type;
    
    const isMountainDistrict = mountainIndigenousDistricts.some(
      md => md.city === city && md.district === district
    );
    
    const indigenousCouncilDistricts = getIndigenousCouncilorDistricts(city, positionId);
    
    const councilDistrictName = selectedElectoralDistrict || (mapping && !mapping.isSplit ? mapping.districtName : null);
    const councilDistrictUrl = district && councilDistrictName
      ? getCouncilorDistrictUrl(city, district, positionId, null, councilDistrictName)
      : `${baseUrl}candidates/district/${positionId}/${city}/`;
    
    if (directMunicipalities.includes(city)) {
      ballots.push({
        name: '直轄市長',
        color: '白色',
        scope: `${city}全市`,
        positionLink: `${baseUrl}positions/mayor-municipal/`,
        candidateListUrl: `${baseUrl}candidates/district/mayor-municipal/${city}/`
      });
      
      const councilScope = councilDistrictName 
        ? `${city}${councilDistrictName}`
        : (district ? `${city}${district}所屬選區` : '依戶籍所在選區');
      
      ballots.push({
        name: '直轄市議員',
        color: '綠色',
        scope: councilScope,
        positionLink: `${baseUrl}positions/councilor-municipal/`,
        candidateListUrl: councilDistrictUrl
      });
      
      if (indigenous === 'plains' && indigenousCouncilDistricts.plains) {
        ballots.push({
          name: '平地原住民議員',
          color: '黃色',
          scope: `${city}全市（${indigenousCouncilDistricts.plains.name}）`,
          positionLink: `${baseUrl}positions/councilor-municipal/`,
          candidateListUrl: indigenousCouncilDistricts.plains.url,
          isIndigenous: true
        });
      } else if (indigenous === 'mountain' && indigenousCouncilDistricts.mountain) {
        ballots.push({
          name: '山地原住民議員',
          color: '藍色',
          scope: `${city}全市（${indigenousCouncilDistricts.mountain.name}）`,
          positionLink: `${baseUrl}positions/councilor-municipal/`,
          candidateListUrl: indigenousCouncilDistricts.mountain.url,
          isIndigenous: true
        });
      }
      
      if (isMountainDistrict) {
        ballots.push({
          name: '區長',
          color: '依公告',
          scope: `${city}${district}`,
          positionLink: `${baseUrl}positions/district-mayor/`,
          candidateListUrl: `${baseUrl}candidates/district/district-mayor/${city}/${district}/`,
          special: true
        });
        ballots.push({
          name: '區民代表',
          color: '依公告',
          scope: `${district}所屬選區`,
          positionLink: `${baseUrl}positions/district-representative/`,
          candidateListUrl: `${baseUrl}candidates/district/district-representative/${city}/${district}/`,
          special: true
        });
      }
      
      ballots.push({
        name: '里長',
        color: '白色或粉紅色',
        scope: '戶籍所在里',
        positionLink: `${baseUrl}positions/village-chief/`,
        candidateListUrl: district ? `${baseUrl}candidates/district/village-chief/${city}/${district}/` : null
      });
      
    } else if (provincialCities.includes(city)) {
      ballots.push({
        name: '市長',
        color: '白色',
        scope: `${city}全市`,
        positionLink: `${baseUrl}positions/mayor-county/`,
        candidateListUrl: `${baseUrl}candidates/district/mayor-county/${city}/`
      });
      
      const councilScope = councilDistrictName 
        ? `${city}${councilDistrictName}`
        : (district ? `${city}${district}所屬選區` : '依戶籍所在選區');
      
      ballots.push({
        name: '市議員',
        color: '綠色',
        scope: councilScope,
        positionLink: `${baseUrl}positions/councilor-county/`,
        candidateListUrl: councilDistrictUrl
      });
      
      if (indigenous === 'plains' && indigenousCouncilDistricts.plains) {
        ballots.push({
          name: '平地原住民議員',
          color: '黃色',
          scope: `${city}全市（${indigenousCouncilDistricts.plains.name}）`,
          positionLink: `${baseUrl}positions/councilor-county/`,
          candidateListUrl: indigenousCouncilDistricts.plains.url,
          isIndigenous: true
        });
      } else if (indigenous === 'mountain' && indigenousCouncilDistricts.mountain) {
        ballots.push({
          name: '山地原住民議員',
          color: '藍色',
          scope: `${city}全市（${indigenousCouncilDistricts.mountain.name}）`,
          positionLink: `${baseUrl}positions/councilor-county/`,
          candidateListUrl: indigenousCouncilDistricts.mountain.url,
          isIndigenous: true
        });
      }
      
      ballots.push({
        name: '里長',
        color: '白色或粉紅色',
        scope: '戶籍所在里',
        positionLink: `${baseUrl}positions/village-chief/`,
        candidateListUrl: district ? `${baseUrl}candidates/district/village-chief/${city}/${district}/` : null
      });
      
    } else {
      ballots.push({
        name: '縣長',
        color: '白色',
        scope: `${city}全縣`,
        positionLink: `${baseUrl}positions/mayor-county/`,
        candidateListUrl: `${baseUrl}candidates/district/mayor-county/${city}/`
      });
      
      const councilScope = councilDistrictName 
        ? `${city}${councilDistrictName}`
        : (district ? `${city}${district}所屬選區` : '依戶籍所在選區');
      
      ballots.push({
        name: '縣議員',
        color: '綠色',
        scope: councilScope,
        positionLink: `${baseUrl}positions/councilor-county/`,
        candidateListUrl: councilDistrictUrl
      });
      
      if (indigenous === 'plains' && indigenousCouncilDistricts.plains) {
        ballots.push({
          name: '平地原住民議員',
          color: '黃色',
          scope: indigenousCouncilDistricts.plains.name,
          positionLink: `${baseUrl}positions/councilor-county/`,
          candidateListUrl: indigenousCouncilDistricts.plains.url,
          isIndigenous: true
        });
      } else if (indigenous === 'mountain' && indigenousCouncilDistricts.mountain) {
        ballots.push({
          name: '山地原住民議員',
          color: '藍色',
          scope: indigenousCouncilDistricts.mountain.name,
          positionLink: `${baseUrl}positions/councilor-county/`,
          candidateListUrl: indigenousCouncilDistricts.mountain.url,
          isIndigenous: true
        });
      }
      
      ballots.push({
        name: '鄉（鎮、市）長',
        color: '白色',
        scope: district || '戶籍所在鄉鎮市',
        positionLink: `${baseUrl}positions/township-mayor/`,
        candidateListUrl: district ? `${baseUrl}candidates/district/township-mayor/${city}/${district}/` : null
      });
      
      ballots.push({
        name: '鄉（鎮、市）民代表',
        color: '依公告',
        scope: district ? `${district}所屬選區` : '戶籍所在選區',
        positionLink: `${baseUrl}positions/township-representative/`,
        candidateListUrl: district ? `${baseUrl}candidates/district/township-representative/${city}/${district}/` : null
      });
      
      ballots.push({
        name: '村（里）長',
        color: '白色或粉紅色',
        scope: '戶籍所在村里',
        positionLink: `${baseUrl}positions/village-chief/`,
        candidateListUrl: district ? `${baseUrl}candidates/district/village-chief/${city}/${district}/` : null
      });
    }
    
    ballots.push({
      name: '公投第 22 案',
      color: '黃色',
      scope: '全國',
      isReferendum: true,
      question: ballotRules.referendum.question,
      referendumLink: `${baseUrl}voting-day/#公投第-22-案`
    });
    
    const regularBallots = ballots.filter(b => !b.isIndigenous);
    const indigenousBallots = ballots.filter(b => b.isIndigenous);
    
    let html = `
      <p class="text-xs text-neutral-500 mb-3">
        戶籍：${city}${district ? ` ${district}` : ''}${councilDistrictName ? `（${councilDistrictName}）` : ''}${indigenous !== 'none' ? ` · ${indigenous === 'plains' ? '平地' : '山地'}原住民` : ''}
      </p>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-neutral-100">
    `;
    
    let ballotIndex = 0;
    regularBallots.forEach((ballot) => {
      ballotIndex++;
      const candidateUrl = ballot.isReferendum ? ballot.referendumLink : ballot.candidateListUrl;
      const linkText = ballot.isReferendum ? '說明' : '候選人';
      
      html += `
        <tr class="align-top">
          <td class="py-2 pr-3 text-neutral-400 tabular-nums w-6">${ballotIndex}</td>
          <td class="py-2">
            <div class="font-medium text-neutral-800">
              ${ballot.positionLink ? `<a href="${ballot.positionLink}" class="underline underline-offset-2 hover:text-neutral-600">${ballot.name}</a>` : ballot.name}
            </div>
            <div class="text-neutral-500 text-xs mt-0.5">${ballot.scope} · ${ballot.color}</div>
            ${ballot.question ? `<div class="text-neutral-500 text-xs mt-1">「${ballot.question}」</div>` : ''}
          </td>
          <td class="py-2 pl-3 text-right whitespace-nowrap">
            ${candidateUrl ? `<a href="${candidateUrl}" class="text-xs text-neutral-600 underline hover:text-neutral-800">${linkText}</a>` : ''}
          </td>
        </tr>
      `;
    });
    
    if (indigenousBallots.length > 0) {
      indigenousBallots.forEach((ballot) => {
        ballotIndex++;
        html += `
          <tr class="align-top bg-neutral-50">
            <td class="py-2 pr-3 text-neutral-400 tabular-nums w-6">${ballotIndex}</td>
            <td class="py-2">
              <div class="font-medium text-neutral-800">
                ${ballot.positionLink ? `<a href="${ballot.positionLink}" class="underline underline-offset-2 hover:text-neutral-600">${ballot.name}</a>` : ballot.name}
                <span class="text-xs text-neutral-400 font-normal ml-1">原住民</span>
              </div>
              <div class="text-neutral-500 text-xs mt-0.5">${ballot.scope} · ${ballot.color}</div>
            </td>
            <td class="py-2 pl-3 text-right whitespace-nowrap">
              ${ballot.candidateListUrl ? `<a href="${ballot.candidateListUrl}" class="text-xs text-neutral-600 underline hover:text-neutral-800">候選人</a>` : ''}
            </td>
          </tr>
        `;
      });
    }
    
    html += `
        </tbody>
      </table>
      <p class="text-xs text-neutral-500 mt-4 pt-3 border-t border-neutral-100">
        實際選票以投票當日領取為準。18-19 歲僅可投公投（第 22 案）。
      </p>
    `;
    
    resultsContent.innerHTML = html;
    resultsSection.classList.remove('hidden');
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
